@page "/players/{Id:guid}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using ScorerApp.Domain.Models
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider Auth
@inject IStringLocalizer<SharedResource> S

<PageTitle>@(_player?.Name ?? S["Player"]) — ScorerApp</PageTitle>

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-4">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">@S["Loading"]</span>
    </div>
}
else if (_player is null)
{
    <div class="alert alert-warning mt-4">@S["PlayerDetail_NotFound"]</div>
}
else
{
    <div class="ui-page-header ui-anim-fade-up">
        <div class="d-flex align-items-center gap-3">
            <a href="/players" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
            <h3 class="m-0"><i class="bi bi-person-circle me-2"></i>@_player.Name</h3>
            @if (!string.IsNullOrEmpty(_player.Nickname))
            {
                <span class="badge bg-secondary">@_player.Nickname</span>
            }
        </div>
        @if (_isAdmin)
        {
            <a href="/admin/players/@_player.Guid/edit" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-pencil me-1"></i>@S["PlayerDetail_Edit"]
            </a>
        }
    </div>

    <div class="row g-4">
        <!-- Info -->
        <div class="col-md-4">
            <div class="ui-panel ui-anim-fade-up">
                <div class="ui-panel-header">
                    <span class="ui-panel-title"><i class="bi bi-person text-accent"></i> @S["PlayerDetail_Info"]</span>
                </div>
                <div class="p-3">
                    <dl class="row mb-0">
                        <dt class="col-5 text-muted">@S["PlayerDetail_Name"]</dt>
                        <dd class="col-7">@_player.Name</dd>
                        <dt class="col-5 text-muted">@S["PlayerDetail_Nickname"]</dt>
                        <dd class="col-7">@(_player.Nickname ?? "—")</dd>
                        <dt class="col-5 text-muted">@S["PlayerDetail_DateOfBirth"]</dt>
                        <dd class="col-7">@(_player.DateOfBirth?.ToString("dd.MM.yyyy") ?? "—")</dd>
                    </dl>
                </div>
            </div>

            <!-- Teams -->
            @if (_player.TeamPlayers.Any())
            {
                <div class="ui-panel ui-anim-fade-up mt-3">
                    <div class="ui-panel-header">
                        <span class="ui-panel-title"><i class="bi bi-shield text-accent"></i> @S["PlayerDetail_Teams"]</span>
                    </div>
                    <div class="p-3">
                        @foreach (var tp in _player.TeamPlayers)
                        {
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <a href="/teams/@tp.Team.Guid" class="text-decoration-none fw-semibold">@tp.Team.Name</a>
                                @if (!string.IsNullOrEmpty(tp.Position))
                                {
                                    <span class="badge bg-secondary small">@tp.Position</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Career stats -->
        @if (_events.Count > 0)
        {
            <div class="col-md-4">
                <div class="ui-panel ui-anim-fade-up">
                    <div class="ui-panel-header">
                        <span class="ui-panel-title"><i class="bi bi-bar-chart-fill text-accent"></i> @S["PlayerDetail_CareerStats"]</span>
                    </div>
                    <div class="p-3">
                        <dl class="row mb-0 small">
                            @if (_events.Any(e => e.Type == MatchEventType.Goal || e.Type == MatchEventType.PenaltyGoal))
                            {
                                <dt class="col-7 text-muted">⚽ @S["PlayerDetail_Goals"]</dt>
                                <dd class="col-5 fw-bold">@_events.Count(e => e.Type == MatchEventType.Goal || e.Type == MatchEventType.PenaltyGoal)</dd>
                            }
                            @if (_events.Any(e => e.Type == MatchEventType.Assist))
                            {
                                <dt class="col-7 text-muted">👟 @S["PlayerDetail_Assists"]</dt>
                                <dd class="col-5 fw-bold">@_events.Count(e => e.Type == MatchEventType.Assist)</dd>
                            }
                            @if (_events.Any(e => e.Type == MatchEventType.YellowCard))
                            {
                                <dt class="col-7 text-muted">🟨 @S["PlayerDetail_YellowCards"]</dt>
                                <dd class="col-5 fw-bold">@_events.Count(e => e.Type == MatchEventType.YellowCard)</dd>
                            }
                            @if (_events.Any(e => e.Type == MatchEventType.RedCard))
                            {
                                <dt class="col-7 text-muted">🟥 @S["PlayerDetail_RedCards"]</dt>
                                <dd class="col-5 fw-bold">@_events.Count(e => e.Type == MatchEventType.RedCard)</dd>
                            }
                            @if (_events.Any(e => e.Type == MatchEventType.CleanSheet))
                            {
                                <dt class="col-7 text-muted">🧤 @S["PlayerDetail_CleanSheets"]</dt>
                                <dd class="col-5 fw-bold">@_events.Count(e => e.Type == MatchEventType.CleanSheet)</dd>
                            }
                            @if (_events.Any(e => e.Type == MatchEventType.Ace))
                            {
                                <dt class="col-7 text-muted">🎾 @S["PlayerDetail_Aces"]</dt>
                                <dd class="col-5 fw-bold">@_events.Count(e => e.Type == MatchEventType.Ace)</dd>
                            }
                            @if (_events.Any(e => e.Type == MatchEventType.LegWon))
                            {
                                <dt class="col-7 text-muted">🎯 @S["PlayerDetail_Legs"]</dt>
                                <dd class="col-5 fw-bold">@_events.Count(e => e.Type == MatchEventType.LegWon)</dd>
                            }
                            <dt class="col-7 text-muted">@S["PlayerDetail_TotalEvents"]</dt>
                            <dd class="col-5 fw-bold">@_events.Count</dd>
                        </dl>
                    </div>
                </div>
            </div>
        }

        <!-- Season history -->
        <div class="@(_events.Count > 0 ? "col-md-4" : "col-md-8")">
            <div class="ui-panel ui-anim-fade-up">
                <div class="ui-panel-header">
                    <span class="ui-panel-title"><i class="bi bi-bar-chart text-accent"></i> @S["PlayerDetail_SeasonHistory"]</span>
                </div>
                @if (!_seasonParticipations.Any())
                {
                    <div class="p-4 text-muted text-center">@S["PlayerDetail_NoSeasons"]</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr><th>@S["PlayerDetail_Season"]</th><th>@S["PlayerDetail_League"]</th><th>@S["Sport"]</th><th class="text-center">ELO</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var sp in _seasonParticipations)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <a href="/seasons/@sp.Season.Guid" class="text-decoration-none">@sp.Season.Name</a>
                                        </td>
                                        <td class="text-muted small">@sp.Season.League.Name</td>
                                        <td class="text-muted small">@sp.Season.League.Sport.Name</td>
                                        <td class="text-center text-muted small">@sp.EloRating.ToString("F0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private bool _loading = true, _isAdmin;
    private Player? _player;
    private List<SeasonParticipant> _seasonParticipations = new();
    private List<MatchEvent> _events = new();

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = (await Auth.GetAuthenticationStateAsync()).User.IsInRole("Admin");
        await using var db = await DbFactory.CreateDbContextAsync();
        _player = await db.Players
            .Include(p => p.TeamPlayers).ThenInclude(tp => tp.Team)
            .FirstOrDefaultAsync(p => p.Guid == Id);

        if (_player is not null)
        {
            // Sekvenčně — jeden DbContext neunese dvě souběžné operace
            // (InvalidOperationException: A second operation was started…).
            _seasonParticipations = await db.SeasonParticipants
                .Where(sp => sp.PlayerId == Id)
                .Include(sp => sp.Season).ThenInclude(s => s.League).ThenInclude(l => l.Sport)
                .OrderByDescending(sp => sp.Season.Year)
                .ToListAsync();

            _events = await db.MatchEvents
                .Where(e => e.PlayerId == Id)
                .ToListAsync();
        }
        _loading = false;
    }
}
