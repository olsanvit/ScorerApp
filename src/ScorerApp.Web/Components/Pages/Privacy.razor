@page "/privacy"
@layout MainLayout
@inject IStringLocalizer<SharedResource> S

<PageTitle>@S["Privacy_Title"] — ScorerApp</PageTitle>

<div class="ui-panel ui-anim-fade-up p-4" style="max-width:760px;margin:0 auto;">

<h3 class="mb-3">@S["Privacy_Title"] — ScorerApp</h3>
<p class="text-muted small">@S["Privacy_EffectiveDate"]</p>

<h5 class="mt-4">@S["Privacy_DataHeading"]</h5>
<p>@S["Privacy_DataAccount"]</p>
<p>@S["Privacy_DataContent"]</p>

<h5 class="mt-4">@S["Privacy_UseHeading"]</h5>
<p>@S["Privacy_UseText"]</p>

<h5 class="mt-4">@S["Privacy_StorageHeading"]</h5>
<p>@S["Privacy_StorageText"]</p>

<h5 class="mt-4">@S["Privacy_CookiesHeading"]</h5>
<p>@S["Privacy_CookiesText"]</p>

<h5 class="mt-4">@S["Privacy_DeletionHeading"]</h5>
<p>@S["Privacy_DeletionText"]</p>

<h5 class="mt-4">@S["Privacy_ChildrenHeading"]</h5>
<p>@S["Privacy_ChildrenText"]</p>

<h5 class="mt-4">@S["Privacy_ContactHeading"]</h5>
<p>@S["Privacy_ContactText"] <a href="mailto:olsanskyvitek@gmail.com">olsanskyvitek@gmail.com</a></p>

</div>
