@page "/seasons"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider Auth
@inject IStringLocalizer<SharedResource> S
@inject ScorerApp.Domain.Services.SeasonFormatService Formats

<PageTitle>@S["Seasons_Title"] — ScorerApp</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <h3><i class="bi bi-calendar3"></i> @S["Seasons_Title"]</h3>
    @if (_isAdmin)
    {
        <a href="/admin/seasons/create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus me-1"></i>@S["NewSeason"]
        </a>
    }
</div>

<UiSearchBar @bind-Value="_search"
             Placeholder="@S["Seasons_SearchPlaceholder"]"
             Count="@_filtered.Count"
             CountLabel="@S["Seasons_CountLabel"]"
             OnSearch="() => StateHasChanged()" />

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">@S["Loading"]</span>
    </div>
}
else
{
    <!-- Status filter -->
    <div class="d-flex gap-2 mb-3 flex-wrap ui-anim-fade-up">
        @foreach (var (label, filter) in _statusFilters)
        {
            <button class="btn btn-sm @(_statusFilter == filter ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => { _statusFilter = filter; StateHasChanged(); }">@label</button>
        }
    </div>

    <div class="ui-panel ui-anim-fade-up">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>@S["Seasons_Season"]</th>
                        <th>@S["Seasons_League"]</th>
                        <th>@S["Sport"]</th>
                        <th>@S["Seasons_Status"]</th>
                        <th>@S["Seasons_Format"]</th>
                        <th class="text-center">@S["Seasons_Participants"]</th>
                        <th class="text-center">@S["Seasons_Matches"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_filtered.Any())
                    {
                        <tr><td colspan="8" class="text-muted text-center py-4">@S["Seasons_Empty"]</td></tr>
                    }
                    @foreach (var s in _filtered)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a href="/seasons/@s.Guid" class="text-decoration-none">@s.Name</a>
                            </td>
                            <td class="text-muted small">
                                <a href="/leagues/@s.League.Guid" class="text-decoration-none text-muted">@s.League.Name</a>
                            </td>
                            <td class="text-muted small">
                                <i class="bi @s.League.Sport.Icon me-1"></i>@s.League.Sport.Name
                            </td>
                            <td>
                                <span class="badge @s.Status.Badge()">@S[$"SeasonStatus_{s.Status}"]</span>
                            </td>
                            <td class="text-muted small">@Formats.Describe(Formats.Resolve(s))</td>
                            <td class="text-center text-muted small">@Count(s).Participants</td>
                            <td class="text-center text-muted small">
                                @Count(s).Played / @Count(s).Matches
                            </td>
                            <td>
                                <a href="/seasons/@s.Guid" class="btn btn-outline-secondary btn-sm">@S["Seasons_Detail"]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool _loading = true, _isAdmin;
    private string _search = "";
    private SeasonStatus? _statusFilter;
    private List<Season> _seasons = new();
    private Dictionary<Guid, ScorerApp.Domain.Services.SeasonCount> _counts = new();
    private ScorerApp.Domain.Services.SeasonCount Count(Season s) => _counts.GetValueOrDefault(s.Guid);

    // Vlastnost místo static pole — texty se musí vyhodnotit v jazyce aktuálního uživatele.
    private (string, SeasonStatus?)[] _statusFilters =>
    [
        (S["Seasons_FilterAll"].Value, null),
        (S["Seasons_FilterInProgress"].Value, SeasonStatus.InProgress),
        (S["Seasons_FilterRegistration"].Value, SeasonStatus.Registration),
        (S["Seasons_FilterDraft"].Value, SeasonStatus.Draft),
        (S["Seasons_FilterCompleted"].Value, SeasonStatus.Completed)
    ];

    private List<Season> _filtered => _seasons
        .Where(s => (_statusFilter is null || s.Status == _statusFilter)
                 && (string.IsNullOrWhiteSpace(_search)
                     || s.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                     || s.League.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = (await Auth.GetAuthenticationStateAsync()).User.IsInRole("Admin");
        await using var db = await DbFactory.CreateDbContextAsync();
        _seasons = await db.Seasons
            .Include(s => s.League).ThenInclude(l => l.Sport)
            .OrderByDescending(s => s.Year).ThenBy(s => s.Name)
            .ToListAsync();
        _counts = await ScorerApp.Domain.Services.SeasonCounts.LoadAsync(db, _seasons.Select(s => s.Guid).ToList());
        _loading = false;
    }

}
