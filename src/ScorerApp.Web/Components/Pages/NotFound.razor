@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<SharedResource> S

<PageTitle>@S["NotFound_Title"] — ScorerApp</PageTitle>

<div class="ui-panel ui-anim-fade-up p-5 text-center" style="max-width:520px;margin:3rem auto;">
    <i class="bi bi-compass fs-1 text-accent d-block mb-3"></i>
    <h3 class="mb-2">@S["NotFound_Title"]</h3>
    <p class="text-muted mb-4">@S["NotFound_Text"]</p>
    <a href="/" class="btn btn-primary">
        <i class="bi bi-house-door me-1"></i>@S["NotFound_BackToDashboard"]
    </a>
</div>
