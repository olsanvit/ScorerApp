@* AUDIT:FIXED|byl: výsledky bez Admin role; nyní jen Admin *@
@page "/matches/{Id:guid}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject SharedServices.ToastService Toast
@inject ScorerApp.Domain.Services.SeasonScheduleService Schedule
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS
@inject ConfirmService Confirm
@inject IStringLocalizer<SharedResource> S

<PageTitle>@S["Match_PageTitle"] — ScorerApp</PageTitle>

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-4">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">@S["Loading"]</span>
    </div>
}
else if (_match is null)
{
    <div class="alert alert-warning mt-4">@S["Match_NotFound"]</div>
}
else
{
    <div class="ui-page-header ui-anim-fade-up">
        <div class="d-flex align-items-center gap-3">
            <a href="/seasons/@_match.Season.Guid/matches" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
            <h3 class="m-0">@S["Match_Round", _match.Round]</h3>
            <span class="badge @StatusBadge(_match.Status)">@StatusLabel(_match.Status)</span>
        </div>
    </div>

    <!-- Score panel -->
    <div class="ui-panel ui-anim-fade-up mb-4">
        <div class="p-4 text-center">
            <div class="row align-items-center g-3">
                <div class="col-5 text-end">
                    <div class="fw-bold fs-5">@_match.HomeParticipant.DisplayName</div>
                    <div class="text-muted small">@S["Match_Home"]</div>
                </div>
                <div class="col-2">
                    @if (_match.Status == MatchStatus.Played)
                    {
                        <div class="fw-bold fs-3 text-accent">@_match.HomeScore : @_match.AwayScore</div>
                        @if (_match.ExtraTime == true)
                        {
                            <div class="text-muted small">@(_match.Penalties == true ? S["Match_PenaltiesShort"] : S["Match_OvertimeShort"])</div>
                        }
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">vs</span>
                    }
                </div>
                <div class="col-5 text-start">
                    <div class="fw-bold fs-5">@_match.AwayParticipant.DisplayName</div>
                    <div class="text-muted small">@S["Match_Away"]</div>
                </div>
            </div>
            @if (_match.MatchDate.HasValue)
            {
                <div class="text-muted small mt-2">@_match.MatchDate.Value.ToString("dd.MM.yyyy")</div>
            }
            @if (_isAdmin && _match.Status == MatchStatus.Played && !_showFixResult)
            {
                <div class="mt-3">
                    <button class="btn btn-outline-warning btn-sm" @onclick="() => _showFixResult = true">
                        <i class="bi bi-pencil-square me-1"></i>@S["Match_FixResult"]
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Fix result (admin only, already played) -->
    @if (_isAdmin && _match.Status == MatchStatus.Played && _showFixResult)
    {
        <div class="ui-panel ui-anim-fade-up mb-4 border border-warning border-opacity-25">
            <div class="ui-panel-header">
                <span class="ui-panel-title"><i class="bi bi-pencil-square text-warning"></i> @S["Match_FixResult"]</span>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _showFixResult = false">@S["Cancel"]</button>
            </div>
            <div class="p-3">
                <div class="alert alert-warning py-2 small mb-3">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    @* Text dříve tvrdil, že se ELO neaktualizuje — FixResultAsync ale přepočítá celou sezónu. *@
                    @S["Match_FixWarning"] <strong>@S["Match_FixWarningRecalc"]</strong>.
                </div>
                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small text-muted">@S["Match_Date"]</label>
                        <input type="date" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                               @bind="_editDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">@_match.HomeParticipant.DisplayName</label>
                        <input type="number" min="0" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                               @bind="_editHome" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">@_match.AwayParticipant.DisplayName</label>
                        <input type="number" min="0" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                               @bind="_editAway" />
                    </div>
                    <div class="col-md-2">
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" id="fix-ot" @bind="_editOT" />
                            <label class="form-check-label small" for="fix-ot">@S["Match_Overtime"]</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" id="fix-pk" @bind="_editPK" />
                            <label class="form-check-label small" for="fix-pk">@S["Match_Penalties"]</label>
                        </div>
                    </div>
                    @if (_editPK)
                    {
                        @* Penaltové skóre rozhoduje vítěze v playoff — bez něj pavouk nepokračuje. *@
                        <div class="col-md-4">
                            <label class="form-label small text-muted">@S["Match_PenaltyScore"]</label>
                            <div class="d-flex align-items-center gap-1">
                                <input type="number" min="0" class="form-control form-control-sm text-center"
                                       style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                       @bind="_editPkHome" />
                                <span class="text-muted">:</span>
                                <input type="number" min="0" class="form-control form-control-sm text-center"
                                       style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                       @bind="_editPkAway" />
                            </div>
                        </div>
                    }
                    <div class="col-md-2">
                        <button class="btn btn-warning btn-sm w-100" @onclick="FixResultAsync" disabled="@_fixingSaving">
                            @if (_fixingSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            @S["Match_OverwriteResult"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Result entry -->
    @if (_isAdmin && _match.Status != MatchStatus.Played)
    {
        <div class="ui-panel ui-anim-fade-up mb-4">
            <div class="ui-panel-header">
                <span class="ui-panel-title"><i class="bi bi-pencil text-accent"></i> @S["Match_EnterResult"]</span>
            </div>
            <div class="p-3">
                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small text-muted">@S["Match_Date"]</label>
                        <input type="date" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                               @bind="_editDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">@_match.HomeParticipant.DisplayName</label>
                        <input type="number" min="0" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                               @bind="_editHome" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">@_match.AwayParticipant.DisplayName</label>
                        <input type="number" min="0" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                               @bind="_editAway" />
                    </div>
                    <div class="col-md-2">
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" id="ot" @bind="_editOT" />
                            <label class="form-check-label small" for="ot">@S["Match_Overtime"]</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" id="pk" @bind="_editPK" />
                            <label class="form-check-label small" for="pk">@S["Match_Penalties"]</label>
                        </div>
                    </div>
                    @if (_editPK)
                    {
                        @* Penaltové skóre rozhoduje vítěze v playoff — bez něj pavouk nepokračuje. *@
                        <div class="col-md-4">
                            <label class="form-label small text-muted">@S["Match_PenaltyScore"]</label>
                            <div class="d-flex align-items-center gap-1">
                                <input type="number" min="0" class="form-control form-control-sm text-center"
                                       style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                       @bind="_editPkHome" />
                                <span class="text-muted">:</span>
                                <input type="number" min="0" class="form-control form-control-sm text-center"
                                       style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                       @bind="_editPkAway" />
                            </div>
                        </div>
                    }
                    <div class="col-md-2">
                        <button class="btn btn-success btn-sm w-100" @onclick="SaveResultAsync" disabled="@_saving">
                            @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            @S["Match_SaveResult"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Events -->
    <div class="ui-panel ui-anim-fade-up mb-4">
        <div class="ui-panel-header">
            <span class="ui-panel-title"><i class="bi bi-list-ul text-accent"></i> @S["Match_Events"]</span>
            @if (_isAdmin)
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleAddEvent">
                    <i class="bi bi-plus me-1"></i>@S["Match_Add"]
                </button>
            }
        </div>

        @if (_showAddEvent)
        {
            <div class="p-3 border-bottom border-opacity-10">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small text-muted">@S["Match_Type"]</label>
                        <select class="form-select form-select-sm"
                                style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                @bind="_newEventType">
                            @foreach (var t in Enum.GetValues<MatchEventType>())
                            {
                                <option value="@t">@EventLabel(t)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">@S["Match_Minute"]</label>
                        <input type="number" min="1" max="120" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                               @bind="_newEventMinute" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted">@S["Player"]</label>
                        <select class="form-select form-select-sm"
                                style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                @bind="_newEventPlayerId">
                            <option value="">@S["Match_Optional"]</option>
                            @if (_homePlayers.Any())
                            {
                                <optgroup label="@_match!.HomeParticipant.DisplayName">
                                    @foreach (var p in _homePlayers)
                                    {
                                        <option value="@p.Guid">@p.Name</option>
                                    }
                                </optgroup>
                            }
                            @if (_awayPlayers.Any())
                            {
                                <optgroup label="@_match!.AwayParticipant.DisplayName">
                                    @foreach (var p in _awayPlayers)
                                    {
                                        <option value="@p.Guid">@p.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted">@S["Match_Note"]</label>
                        <input class="form-control form-control-sm"
                               style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                               @bind="_newEventNote" />
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary btn-sm w-100" @onclick="AddEventAsync">@S["Match_Add"]</button>
                    </div>
                </div>
            </div>
        }

        @if (!_match.MatchEvents.Any())
        {
            <div class="p-3 text-muted text-center small">@S["Match_NoEvents"]</div>
        }
        else
        {
            <div class="px-3 py-2">
                @foreach (var e in _match.MatchEvents.OrderBy(e => e.Minute ?? 999))
                {
                    <div class="d-flex align-items-center gap-3 py-2 border-bottom border-opacity-10">
                        <div class="text-muted small text-end" style="min-width:36px">
                            @(e.Minute.HasValue ? $"{e.Minute}'" : "—")
                        </div>
                        <div style="font-size:1.2rem;min-width:28px;text-align:center">
                            @EventIcon(e.Type)
                        </div>
                        <div class="flex-grow-1">
                            <span class="fw-semibold small">@EventLabel(e.Type)</span>
                            @if (e.Player is not null)
                            {
                                <span class="text-muted small ms-2">— @e.Player.Name</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(e.Notes))
                            {
                                <div class="text-muted" style="font-size:.75rem">@e.Notes</div>
                            }
                        </div>
                        @if (_isAdmin)
                        {
                            <button class="btn btn-outline-danger btn-sm px-2"
                                    title="@S["Match_DeleteEvent"]" @onclick="() => DeleteEventAsync(e.Guid)">
                                <i class="bi bi-trash"></i>
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- Sets -->
    @if (_match.MatchSets.Any() || _isAdmin)
    {
        <div class="ui-panel ui-anim-fade-up mb-4">
            <div class="ui-panel-header">
                <span class="ui-panel-title"><i class="bi bi-grid-3x2 text-accent"></i> @S["Match_Sets"]</span>
                @if (_isAdmin)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleAddSet">
                        <i class="bi bi-plus me-1"></i>@S["Match_Add"]
                    </button>
                }
            </div>

            @if (_showAddSet)
            {
                <div class="p-3 border-bottom border-opacity-10">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label small text-muted">@S["Match_SetNumber"]</label>
                            <input type="number" min="1" max="99" class="form-control form-control-sm"
                                   style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                   @bind="_newSetNumber" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">@S["Match_Home"]</label>
                            <input type="number" min="0" class="form-control form-control-sm"
                                   style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                   @bind="_newSetHome" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">@S["Match_Away"]</label>
                            <input type="number" min="0" class="form-control form-control-sm"
                                   style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                   @bind="_newSetAway" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">@S["Match_TbHome"]</label>
                            <input type="number" min="0" class="form-control form-control-sm"
                                   style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                   @bind="_newSetTBHome" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted">@S["Match_TbAway"]</label>
                            <input type="number" min="0" class="form-control form-control-sm"
                                   style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                   @bind="_newSetTBAway" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary btn-sm w-100" @onclick="AddSetAsync">@S["Match_Add"]</button>
                        </div>
                    </div>
                </div>
            }

            @if (!_match.MatchSets.Any())
            {
                <div class="p-3 text-muted text-center small">@S["Match_NoSets"]</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="text-center" style="width:60px">@S["Match_Set"]</th>
                                <th class="text-center">@_match.HomeParticipant.DisplayName</th>
                                <th class="text-center">@_match.AwayParticipant.DisplayName</th>
                                <th class="text-center">@S["Winner"]</th>
                                @if (_isAdmin) { <th></th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _match.MatchSets.OrderBy(s => s.SetNumber))
                            {
                                var homeWon = s.HomeGames > s.AwayGames;
                                var score = s.TiebreakHome.HasValue
                                    ? $"{s.HomeGames}-{s.AwayGames} ({s.TiebreakHome}/{s.TiebreakAway})"
                                    : $"{s.HomeGames}-{s.AwayGames}";
                                <tr>
                                    <td class="text-center fw-bold text-muted">@s.SetNumber</td>
                                    <td class="text-center @(homeWon ? "fw-bold text-accent" : "text-muted")">@s.HomeGames</td>
                                    <td class="text-center @(!homeWon ? "fw-bold text-accent" : "text-muted")">@s.AwayGames</td>
                                    <td class="text-center small">
                                        @if (homeWon)
                                        {
                                            <span class="badge bg-success">@_match.HomeParticipant.DisplayName</span>
                                        }
                                        else if (s.AwayGames > s.HomeGames)
                                        {
                                            <span class="badge bg-success">@_match.AwayParticipant.DisplayName</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@S["Match_Draw"]</span>
                                        }
                                    </td>
                                    @if (_isAdmin)
                                    {
                                        <td>
                                            <button class="btn btn-outline-danger btn-sm px-2"
                                                    title="@S["Match_DeleteSet"]" @onclick="() => DeleteSetAsync(s.Guid)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <!-- Tennis-style summary -->
                <div class="px-3 pb-2 text-muted small">
                    @(S["Match_SetProgress", string.Join(", ", _match.MatchSets.OrderBy(s => s.SetNumber).Select(s => $"{s.HomeGames}-{s.AwayGames}"))])
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_match.Notes))
    {
        <div class="ui-panel ui-anim-fade-up p-3">
            <div class="text-muted small"><i class="bi bi-sticky me-1"></i>@_match.Notes</div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }
    private bool _loading = true, _saving, _showAddEvent, _isAdmin;
    private Match? _match;
    private List<Player> _homePlayers = new();
    private List<Player> _awayPlayers = new();
    private bool _showFixResult, _fixingSaving;

    private int _editHome, _editAway;
    private DateOnly? _editDate;
    private bool _editOT, _editPK;
    private int _editPkHome, _editPkAway;

    private MatchEventType _newEventType = MatchEventType.Goal;
    private int? _newEventMinute;
    private Guid? _newEventPlayerId;
    private string _newEventNote = "";

    private bool _showAddSet;
    private int _newSetNumber = 1, _newSetHome, _newSetAway;
    private int? _newSetTBHome, _newSetTBAway;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = (await Auth.GetAuthenticationStateAsync()).User.IsInRole("Admin");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _match = await db.Matches
            .Include(m => m.Season).ThenInclude(s => s.League)
            .Include(m => m.HomeParticipant).ThenInclude(p => p.Player)
            .Include(m => m.HomeParticipant).ThenInclude(p => p.Team)
            .Include(m => m.AwayParticipant).ThenInclude(p => p.Player)
            .Include(m => m.AwayParticipant).ThenInclude(p => p.Team)
            .Include(m => m.MatchEvents).ThenInclude(e => e.Player)
            .Include(m => m.MatchSets)
            .FirstOrDefaultAsync(m => m.Guid == Id);

        if (_match is not null)
        {
            // Load only players belonging to the participating teams (or all if individual match)
            var homeTeamId = _match.HomeParticipant.TeamId;
            var awayTeamId = _match.AwayParticipant.TeamId;

            if (homeTeamId.HasValue)
                _homePlayers = await db.TeamPlayers
                    .Where(tp => tp.TeamId == homeTeamId.Value)
                    .Include(tp => tp.Player)
                    .Select(tp => tp.Player!)
                    .Where(p => !p.IsDeleted)
                    .OrderBy(p => p.Name)
                    .ToListAsync();
            else if (_match.HomeParticipant.PlayerId.HasValue)
            {
                var p = await db.Players.FirstOrDefaultAsync(x => x.Guid == _match.HomeParticipant.PlayerId.Value);
                if (p is not null) _homePlayers = [p];
            }

            if (awayTeamId.HasValue)
                _awayPlayers = await db.TeamPlayers
                    .Where(tp => tp.TeamId == awayTeamId.Value)
                    .Include(tp => tp.Player)
                    .Select(tp => tp.Player!)
                    .Where(p => !p.IsDeleted)
                    .OrderBy(p => p.Name)
                    .ToListAsync();
            else if (_match.AwayParticipant.PlayerId.HasValue)
            {
                var p = await db.Players.FirstOrDefaultAsync(x => x.Guid == _match.AwayParticipant.PlayerId.Value);
                if (p is not null) _awayPlayers = [p];
            }
        }

        if (_match is not null)
        {
            _editHome = _match.HomeScore ?? 0;
            _editAway = _match.AwayScore ?? 0;
            _editDate = _match.MatchDate;
            _editOT   = _match.ExtraTime ?? false;
            _editPK   = _match.Penalties ?? false;
            _editPkHome = _match.HomePenaltyScore ?? 0;
            _editPkAway = _match.AwayPenaltyScore ?? 0;
        }
        _loading = false;
    }

    private async Task SaveResultAsync()
    {
        if (_match is null || !_isAdmin) return;
        _saving = true;
        await using var db = await DbFactory.CreateDbContextAsync();

        var m = await db.Matches
            .Include(x => x.HomeParticipant)
            .Include(x => x.AwayParticipant)
            .Include(x => x.Season)
            .FirstOrDefaultAsync(x => x.Guid == _match.Guid);

        if (m is not null)
        {
            m.HomeScore = _editHome; m.AwayScore = _editAway;
            m.MatchDate = _editDate; m.ExtraTime = _editOT;
            m.Penalties = _editPK;  m.Status     = MatchStatus.Played;
            m.HomePenaltyScore = _editPK ? _editPkHome : null;
            m.AwayPenaltyScore = _editPK ? _editPkAway : null;
            m.UpdatedAt = DateTimeOffset.UtcNow;
            await db.SaveChangesAsync();

            var followUp = await Schedule.AfterResultSavedAsync(m.Guid);
            if (!followUp.Ok) Toast.ShowWarning(S["Match_Warning"].Value, followUp.Error!);

            Toast.ShowSuccess(S["Match_Saved"].Value, S["Match_ResultSaved"].Value);
        }
        _saving = false;
        await LoadAsync();
    }

    private void ToggleAddEvent() => _showAddEvent = !_showAddEvent;

    private async Task AddEventAsync()
    {
        if (_match is null || !_isAdmin) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.MatchEvents.Add(new MatchEvent
        {
            MatchId  = _match.Guid,
            Type     = _newEventType,
            Minute   = _newEventMinute,
            PlayerId = _newEventPlayerId == Guid.Empty ? null : _newEventPlayerId,
            Notes    = string.IsNullOrWhiteSpace(_newEventNote) ? null : _newEventNote
        });
        await db.SaveChangesAsync();
        _showAddEvent = false; _newEventNote = ""; _newEventMinute = null;
        Toast.ShowSuccess(S["Match_Added"].Value, S["Match_EventAdded"].Value);
        await LoadAsync();
    }

    private async Task DeleteEventAsync(Guid eventId)
    {
        if (!_isAdmin) return;
        if (!await Confirm.ShowAsync(S["Match_DeleteEvent"].Value, S["Match_DeleteEventConfirm"].Value, S["Match_Delete"].Value, S["Cancel"].Value))
            return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.MatchEvents.FindAsync(eventId);
        if (e is not null) { db.MatchEvents.Remove(e); await db.SaveChangesAsync(); }
        Toast.ShowSuccess(S["Match_Deleted"].Value, S["Match_EventDeleted"].Value);
        await LoadAsync();
    }

