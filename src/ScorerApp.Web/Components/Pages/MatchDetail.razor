    private async Task FixResultAsync()
    {
        if (_match is null || !_isAdmin) return;
        if (!await Confirm.ShowAsync(S["Match_OverwriteResult"].Value,
                S["Match_OverwriteConfirm", _editHome, _editAway].Value,
                S["Match_Overwrite"].Value, S["Cancel"].Value))
            return;

        _fixingSaving = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var m = await db.Matches
            .Include(x => x.Season)
            .FirstOrDefaultAsync(x => x.Guid == _match.Guid);
        if (m is not null)
        {
            m.HomeScore = _editHome;
            m.AwayScore = _editAway;
            m.MatchDate = _editDate;
            m.ExtraTime = _editOT;
            m.Penalties = _editPK;
            m.HomePenaltyScore = _editPK ? _editPkHome : null;
            m.AwayPenaltyScore = _editPK ? _editPkAway : null;
            m.UpdatedAt = DateTimeOffset.UtcNow;
            await db.SaveChangesAsync();

            var followUp = await Schedule.AfterResultSavedAsync(m.Guid);
            if (!followUp.Ok) Toast.ShowWarning(S["Match_Warning"].Value, followUp.Error!);

            Toast.ShowSuccess(S["Match_Fixed"].Value, S["Match_ResultOverwritten", _editHome, _editAway].Value);
        }
        _fixingSaving = false;
        _showFixResult = false;
        await LoadAsync();
    }

