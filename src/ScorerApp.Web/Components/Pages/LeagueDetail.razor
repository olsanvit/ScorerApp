@* AUDIT:FIXED|byl: smazání dostupné všem; nyní jen Admin *@
@page "/leagues/{Id:guid}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject SharedServices.ToastService Toast
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject ConfirmService Confirm
@inject IStringLocalizer<SharedResource> S
@inject ScorerApp.Domain.Services.SeasonFormatService Formats

<PageTitle>@(_league?.Name ?? S["League_Fallback"].Value) — ScorerApp</PageTitle>

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-4">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">@S["Loading"]</span>
    </div>
}
else if (_league is null)
{
    <div class="alert alert-warning mt-4">@S["League_NotFound"]</div>
}
else
{
    <div class="ui-page-header ui-anim-fade-up">
        <div class="d-flex align-items-center gap-3">
            <a href="/leagues" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
            <h3 class="m-0"><i class="bi @_league.Sport.Icon me-2"></i>@_league.Name</h3>
            <span class="badge bg-secondary">@_league.Sport.Name</span>
        </div>
        <div class="d-flex gap-2">
            @if (_isAdmin)
            {
                <a href="/admin/seasons/create?leagueId=@_league.Guid" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus me-1"></i>@S["NewSeason"]
                </a>
                <a href="/admin/leagues/@_league.Guid/edit" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-pencil me-1"></i>@S["League_Edit"]
                </a>
                <button class="btn btn-outline-danger btn-sm" title="@S["League_Delete"]" @onclick="DeleteLeagueAsync">
                    <i class="bi bi-trash"></i>
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_league.Description))
    {
        <p class="text-muted mb-4 ui-anim-fade-up">@_league.Description</p>
    }

    <!-- Sezóny -->
    <div class="ui-panel ui-anim-fade-up">
        <div class="ui-panel-header">
            <span class="ui-panel-title"><i class="bi bi-calendar3 text-accent"></i> @S["League_Seasons"]</span>
        </div>
        @if (!_league.Seasons.Any())
        {
            <div class="p-4 text-muted text-center">
                <i class="bi bi-calendar-x fs-3 d-block mb-2"></i>
                @S["League_NoSeasons"] <a href="/admin/seasons/create?leagueId=@_league.Guid">@S["League_CreateFirstSeason"]</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>@S["League_Season"]</th>
                            <th>@S["League_Format"]</th>
                            <th>@S["League_Status"]</th>
                            <th class="text-center">@S["League_Participants"]</th>
                            <th class="text-center">@S["League_Matches"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _league.Seasons.OrderByDescending(s => s.Year))
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <a href="/seasons/@s.Guid" class="text-decoration-none">@s.Name</a>
                                </td>
                                <td class="text-muted small">@Formats.Describe(Formats.Resolve(s))</td>
                                <td>
                                    <span class="badge @s.Status.Badge()">@S[$"SeasonStatus_{s.Status}"]</span>
                                </td>
                                <td class="text-center text-muted small">@Count(s).Participants</td>
                                <td class="text-center text-muted small">@Count(s).Matches</td>
                                <td>
                                    <a href="/seasons/@s.Guid" class="btn btn-outline-secondary btn-sm">@S["League_Detail"]</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private bool _loading = true;
    private League? _league;
    private Dictionary<Guid, ScorerApp.Domain.Services.SeasonCount> _counts = new();
    private ScorerApp.Domain.Services.SeasonCount Count(Season s) => _counts.GetValueOrDefault(s.Guid);

    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("Admin");

        await using var db = await DbFactory.CreateDbContextAsync();
        _league = await db.Leagues
            .Include(l => l.Sport)
            .Include(l => l.Seasons)
            .FirstOrDefaultAsync(l => l.Guid == Id);
        if (_league is not null)
            _counts = await ScorerApp.Domain.Services.SeasonCounts.LoadAsync(db, _league.Seasons.Select(s => s.Guid).ToList());
        _loading = false;
    }

    private async Task DeleteLeagueAsync()
    {
        if (_league is null || !_isAdmin) return;
        if (!await Confirm.ShowAsync(S["League_Delete"],
                S["League_DeleteConfirm", _league.Name],
                S["League_DeleteButton"], S["Cancel"]))
            return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var league = await db.Leagues.FindAsync(_league.Guid);
        if (league is not null) { db.Leagues.Remove(league); await db.SaveChangesAsync(); }
        Toast.ShowSuccess(S["League_Deleted"], S["League_DeletedMessage"]);
        Nav.NavigateTo("/leagues");
    }


}
