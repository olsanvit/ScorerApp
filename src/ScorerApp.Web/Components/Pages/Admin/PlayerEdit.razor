@page "/admin/players/{Id:guid}/edit"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject SharedServices.ToastService Toast
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> S

<PageTitle>@S["PlayerForm_Edit"] — ScorerApp</PageTitle>

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-4">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">@S["Loading"]</span>
    </div>
}
else if (_notFound)
{
    <div class="alert alert-warning mt-4">@S["PlayerForm_NotFound"]</div>
}
else
{
    <div class="ui-page-header ui-anim-fade-up">
        <div class="d-flex align-items-center gap-3">
            <a href="/players/@Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
            <h3 class="m-0"><i class="bi bi-person-gear me-2"></i>@S["PlayerForm_Edit"]</h3>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="ui-panel ui-anim-fade-up p-4">
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2 small mb-3">@_error</div>
                }
                <div class="mb-3">
                    <label class="form-label small text-muted">@S["PlayerForm_Name"]</label>
                    <input class="form-control" @bind="_name" placeholder="@S["PlayerForm_NamePlaceholder"]" />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">@S["PlayerForm_Nickname"]</label>
                    <input class="form-control" @bind="_nickname" placeholder="@S["PlayerForm_NicknamePlaceholder"]" />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">@S["PlayerForm_Email"]</label>
                    <input class="form-control" type="email" @bind="_email"
                           placeholder="@S["PlayerForm_EmailPlaceholder"]" />
                    @if (!string.IsNullOrEmpty(_linkedUserId))
                    {
                        <div class="form-text small"><i class="bi bi-link-45deg me-1"></i>@S["PlayerForm_Linked"]</div>
                    }
                </div>
                <div class="mb-4">
                    <label class="form-label small text-muted">@S["PlayerForm_DateOfBirth"]</label>
                    <input type="date" class="form-control" @bind="_dob" />
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @S["PlayerForm_SaveButton"]
                    </button>
                    <a href="/players/@Id" class="btn btn-outline-secondary">@S["Cancel"]</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private string? _linkedUserId;
    private string _name = "", _nickname = "", _email = "", _error = "";
    private DateOnly? _dob;
    private bool _saving, _loading = true, _notFound;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var player = await db.Players.FirstOrDefaultAsync(p => p.Guid == Id);
        if (player is null) { _notFound = true; _loading = false; return; }

        _name     = player.Name;
        _nickname = player.Nickname ?? "";
        _email    = player.Email ?? "";
        _linkedUserId = player.UserId;
        _dob      = player.DateOfBirth;
        _loading  = false;
    }

    private async Task SaveAsync()
    {
        _error = "";
        if (string.IsNullOrWhiteSpace(_name)) { _error = S["PlayerForm_NameRequired"]; return; }

        _saving = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var player = await db.Players.FirstOrDefaultAsync(p => p.Guid == Id);
        if (player is null) { _error = S["PlayerForm_NotFound"]; _saving = false; return; }

        player.Name        = _name.Trim();
        player.Nickname    = string.IsNullOrWhiteSpace(_nickname) ? null : _nickname.Trim();
        player.Email       = string.IsNullOrWhiteSpace(_email) ? null : _email.Trim();
        player.DateOfBirth = _dob;

        await db.SaveChangesAsync();
        _saving = false;
        Toast.ShowSuccess(S["PlayerForm_Done"], S["PlayerForm_Saved", _name]);
        Nav.NavigateTo($"/players/{Id}");
    }
}
