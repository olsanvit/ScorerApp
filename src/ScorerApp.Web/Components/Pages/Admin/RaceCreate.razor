@page "/admin/races/create"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject SharedServices.ToastService Toast
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> S

<PageTitle>@S["RaceForm_Title"] — ScorerApp</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <div class="d-flex align-items-center gap-3">
        @if (_seasonId.HasValue)
        {
            <a href="/seasons/@_seasonId" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        }
        else
        {
            <a href="/admin" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        }
        <h3 class="m-0"><i class="bi bi-person-walking me-2"></i>@S["RaceForm_Title"]</h3>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="ui-panel ui-anim-fade-up p-4">
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2 small mb-3">@_error</div>
            }

            @if (!_seasonId.HasValue)
            {
                @if (!_seasons.Any())
                {
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        @S["RaceForm_NoSeasons"]
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label small text-muted">@S["RaceForm_Season"]</label>
                    <select class="form-select" @bind="_selectedSeasonId">
                        <option value="">@S["RaceForm_ChooseSeason"]</option>
                        @foreach (var s in _seasons)
                        {
                            <option value="@s.Guid">@s.Name (@s.League.Name)</option>
                        }
                    </select>
                </div>
            }

            <div class="mb-3">
                <label class="form-label small text-muted">@S["RaceForm_Name"]</label>
                <input class="form-control" @bind="_name" placeholder="@S["RaceForm_NamePlaceholder"]" />
            </div>
            <div class="mb-3">
                <label class="form-label small text-muted">@S["RaceForm_Date"]</label>
                <input type="date" class="form-control" @bind="_raceDate" />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-7">
                    <label class="form-label small text-muted">@S["RaceForm_Distance"]</label>
                    <input type="number" step="0.01" min="0" class="form-control" @bind="_distance" placeholder="42.195" />
                </div>
                <div class="col-5">
                    <label class="form-label small text-muted">@S["RaceForm_Unit"]</label>
                    <input class="form-control" @bind="_distanceUnit" placeholder="km" />
                </div>
            </div>
            <div class="mb-4">
                <label class="form-label small text-muted">@S["RaceForm_Notes"]</label>
                <textarea class="form-control" rows="3" @bind="_notes" placeholder="@S["RaceForm_NotesPlaceholder"]"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    @S["RaceForm_Create"]
                </button>
                @if (_seasonId.HasValue)
                {
                    <a href="/seasons/@_seasonId" class="btn btn-outline-secondary">@S["Cancel"]</a>
                }
                else
                {
                    <a href="/admin" class="btn btn-outline-secondary">@S["Cancel"]</a>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public Guid? SeasonId { get; set; }

    private Guid? _seasonId;
    private Guid? _selectedSeasonId;
    private string _name = "", _error = "", _distanceUnit = "km", _notes = "";
    private decimal? _distance;
    private DateOnly? _raceDate;
    private bool _saving;
    private List<Season> _seasons = new();

    protected override async Task OnInitializedAsync()
    {
        _seasonId = SeasonId;
        if (_seasonId is null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _seasons = await db.Seasons
                .Include(s => s.League)
                    .ThenInclude(l => l.Sport)
                .Where(s => s.Status == SeasonStatus.InProgress
                            && (s.League.Sport.Type == SportType.Running
                                || s.League.Sport.MatchType == SportMatchType.MultiParticipant))
                .OrderByDescending(s => s.Year)
                .ToListAsync();
        }
    }

    private async Task SaveAsync()
    {
        _error = "";
        var targetSeasonId = _seasonId ?? _selectedSeasonId;
        if (targetSeasonId is null) { _error = S["RaceForm_SeasonRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_name)) { _error = S["RaceForm_NameRequired"]; return; }

        _saving = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var race = new Race
        {
            SeasonId     = targetSeasonId.Value,
            Name         = _name.Trim(),
            RaceDate     = _raceDate,
            Distance     = _distance,
            DistanceUnit = string.IsNullOrWhiteSpace(_distanceUnit) ? null : _distanceUnit.Trim(),
            Notes        = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()
        };
        db.Races.Add(race);
        await db.SaveChangesAsync();
        _saving = false;
        Toast.ShowSuccess(S["RaceForm_Done"], S["RaceForm_Created", _name]);
        Nav.NavigateTo($"/races/{race.Guid}");
    }
}
