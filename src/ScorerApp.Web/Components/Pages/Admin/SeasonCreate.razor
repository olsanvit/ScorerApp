@page "/admin/seasons/create"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject SharedServices.ToastService Toast
@inject NavigationManager Nav
@inject ScorerApp.Domain.Services.SeasonFormatService Formats
@inject IStringLocalizer<SharedResource> S

<PageTitle>@S["NewSeason"] — ScorerApp</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <div class="d-flex align-items-center gap-3">
        <a href="/admin" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <h3 class="m-0"><i class="bi bi-calendar3 me-2"></i>@S["NewSeason"]</h3>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="ui-panel ui-anim-fade-up p-4">
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2 small mb-3">@_error</div>
            }
            <div class="mb-3">
                <label class="form-label small text-muted">@S["SeasonForm_League"]</label>
                <select class="form-select" @bind="_leagueId">
                    <option value="">@S["SeasonForm_SelectLeague"]</option>
                    @foreach (var l in _leagues)
                    {
                        <option value="@l.Guid">@l.Name (@l.Sport.Name)</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label small text-muted">@S["SeasonForm_Name"]</label>
                <input class="form-control" @bind="_name" placeholder="@S["SeasonForm_NamePlaceholder"]" />
            </div>
            <div class="mb-3">
                <label class="form-label small text-muted">@S["SeasonForm_Year"]</label>
                <input type="number" class="form-control" @bind="_year" min="2000" max="2100" />
            </div>
            <div class="mb-3">
                <label class="form-label small text-muted">@S["SeasonFormat"]</label>
                <SeasonFormatBuilder @bind-Definition="_definition" />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="form-label small text-muted">@S["SeasonForm_Start"]</label>
                    <input type="date" class="form-control" @bind="_startDate" />
                </div>
                <div class="col-6">
                    <label class="form-label small text-muted">@S["SeasonForm_End"]</label>
                    <input type="date" class="form-control" @bind="_endDate" />
                </div>
            </div>
            <div class="mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="elo" @bind="_useElo" />
                    <label class="form-check-label" for="elo">@S["SeasonForm_UseElo"]</label>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    @S["SeasonForm_Create"]
                </button>
                <a href="/admin" class="btn btn-outline-secondary">@S["Cancel"]</a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public Guid? LeagueId { get; set; }

    private string _name = "", _error = "";
    private Guid? _leagueId;
    private int _year = DateTime.Now.Year;
    private DateOnly? _startDate, _endDate;
    private bool _useElo, _saving;
    private List<League> _leagues = new();
    // Výchozí formát = jednoduchá tabulka; uživatel ho přepíše šablonou nebo moduly.
    private SeasonFormatDefinition _definition = new()
    {
        Modules = [new SeasonFormatModule { Type = SeasonModuleType.RoundRobin, MatchesPerPair = 1 }]
    };

    /// <summary>
    /// Starý enum se drží kvůli místům, která ještě čtou Season.Format (výpisy, filtry).
    /// Modulární formát je zdroj pravdy, tohle je jen jeho nejbližší přiblížení.
    /// </summary>
    private static SeasonFormat LegacyFormat(SeasonFormatDefinition definition)
    {
        var types = definition.Modules.Select(m => m.Type).ToList();
        if (types.Contains(SeasonModuleType.GroupStage)) return SeasonFormat.GroupsAndKnockout;
        if (types.Count == 1 && types[0] == SeasonModuleType.Playoff) return SeasonFormat.Playoff;
        if (types.Count == 1 && types[0] == SeasonModuleType.RoundRobin)
            return definition.Modules[0].MatchesPerPair >= 2
                ? SeasonFormat.DoubleRoundRobin
                : SeasonFormat.RoundRobin;
        return SeasonFormat.Custom;
    }

    protected override async Task OnInitializedAsync()
    {
        _leagueId = LeagueId;
        await using var db = await DbFactory.CreateDbContextAsync();
        _leagues = await db.Leagues.Include(l => l.Sport).OrderBy(l => l.Name).ToListAsync();
    }

    private async Task SaveAsync()
    {
        _error = "";
        if (_leagueId is null) { _error = S["SeasonForm_LeagueRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_name)) { _error = S["SeasonForm_NameRequired"]; return; }

        _saving = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var season = new Season
        {
            LeagueId  = _leagueId.Value,
            Name      = _name.Trim(),
            Year      = _year,
            Format     = LegacyFormat(_definition),
            FormatJson = Formats.Serialize(_definition),
            Status    = SeasonStatus.Draft,
            UseElo    = _useElo,
            StartDate = _startDate,
            EndDate   = _endDate
        };
        db.Seasons.Add(season);
        await db.SaveChangesAsync();
        _saving = false;
        Toast.ShowSuccess(S["SeasonForm_Done"], S["SeasonForm_Created", _name]);
        Nav.NavigateTo($"/admin/seasons/{season.Guid}/participants");
    }
}
