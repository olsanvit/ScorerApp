@page "/admin/seasons/{Id:guid}/edit"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject SharedServices.ToastService Toast
@inject NavigationManager Nav
@inject ScorerApp.Domain.Services.SeasonFormatService Formats
@inject IStringLocalizer<SharedResource> S

<PageTitle>@S["SeasonForm_EditTitle"] — ScorerApp</PageTitle>

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-4">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">@S["Loading"]</span>
    </div>
}
else if (_notFound)
{
    <div class="alert alert-warning mt-4">@S["SeasonForm_NotFound"]</div>
}
else
{
    <div class="ui-page-header ui-anim-fade-up">
        <div class="d-flex align-items-center gap-3">
            <a href="/seasons/@Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
            <h3 class="m-0"><i class="bi bi-calendar3 me-2"></i>@S["SeasonForm_EditTitle"]</h3>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="ui-panel ui-anim-fade-up p-4">
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2 small mb-3">@_error</div>
                }
                <div class="mb-3">
                    <label class="form-label small text-muted">@S["SeasonForm_LeagueReadonly"]</label>
                    <input class="form-control" value="@_leagueName" disabled />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">@S["SeasonForm_Name"]</label>
                    <input class="form-control" @bind="_name" placeholder="@S["SeasonForm_NamePlaceholder"]" />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">@S["SeasonForm_Year"]</label>
                    <input type="number" class="form-control" @bind="_year" min="2000" max="2100" />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">@S["SeasonFormat"]</label>
                    <SeasonFormatBuilder @bind-Definition="_definition" />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label small text-muted">@S["SeasonForm_Start"]</label>
                        <input type="date" class="form-control" @bind="_startDate" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">@S["SeasonForm_End"]</label>
                        <input type="date" class="form-control" @bind="_endDate" />
                    </div>
                </div>
                <div class="mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="elo" @bind="_useElo" />
                        <label class="form-check-label" for="elo">@S["SeasonForm_UseElo"]</label>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @S["SeasonForm_SaveChanges"]
                    </button>
                    <a href="/seasons/@Id" class="btn btn-outline-secondary">@S["Cancel"]</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private string _name = "", _leagueName = "", _error = "";
    private int _year = DateTime.Now.Year;
    private SeasonFormatDefinition _definition = new();
    private DateOnly? _startDate, _endDate;
    private bool _useElo, _saving, _loading = true, _notFound;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var season = await db.Seasons
            .Include(s => s.League)
            .FirstOrDefaultAsync(s => s.Guid == Id);

        if (season is null) { _notFound = true; _loading = false; return; }

        _name       = season.Name;
        _year       = season.Year;
        // Sezóny založené před modulárním formátem mají FormatJson prázdný — Resolve je
        // odvodí ze starého enumu, takže se editují stejně jako nové.
        _definition = Formats.Resolve(season);
        _useElo     = season.UseElo;
        _startDate  = season.StartDate;
        _endDate    = season.EndDate;
        _leagueName = season.League.Name;
        _loading    = false;
    }

    private async Task SaveAsync()
    {
        _error = "";
        if (string.IsNullOrWhiteSpace(_name)) { _error = S["SeasonForm_NameRequired"]; return; }

        _saving = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var season = await db.Seasons.FirstOrDefaultAsync(s => s.Guid == Id);
        if (season is null) { _error = S["SeasonForm_NotFound"]; _saving = false; return; }

        season.Name      = _name.Trim();
        season.Year      = _year;
        season.Format     = LegacyFormat(_definition);
        season.FormatJson = Formats.Serialize(_definition);
        season.UseElo    = _useElo;
        season.StartDate = _startDate;
        season.EndDate   = _endDate;

        await db.SaveChangesAsync();
        _saving = false;
        Toast.ShowSuccess(S["SeasonForm_Done"], S["SeasonForm_Saved", _name]);
        Nav.NavigateTo($"/seasons/{Id}");
    }

    /// <summary>
    /// Starý enum se drží kvůli místům, která ještě čtou Season.Format (výpisy, filtry).
    /// Modulární formát je zdroj pravdy, tohle je jen jeho nejbližší přiblížení.
    /// </summary>
    private static SeasonFormat LegacyFormat(SeasonFormatDefinition definition)
    {
        var types = definition.Modules.Select(m => m.Type).ToList();
        if (types.Contains(SeasonModuleType.GroupStage)) return SeasonFormat.GroupsAndKnockout;
        if (types.Count == 1 && types[0] == SeasonModuleType.Playoff) return SeasonFormat.Playoff;
        if (types.Count == 1 && types[0] == SeasonModuleType.RoundRobin)
            return definition.Modules[0].MatchesPerPair >= 2
                ? SeasonFormat.DoubleRoundRobin
                : SeasonFormat.RoundRobin;
        return SeasonFormat.Custom;
    }
}
