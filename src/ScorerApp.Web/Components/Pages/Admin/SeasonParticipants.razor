@page "/admin/seasons/{Id:guid}/participants"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ScorerApp.Domain.Services.SeasonScheduleService Schedule
@inject SharedServices.ToastService Toast
@inject ConfirmService Confirm
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> S

<PageTitle>@S["Participants_PageTitle"] — ScorerApp</PageTitle>

@if (_season is null && !_loading)
{
    <div class="alert alert-warning mt-4">@S["Participants_SeasonNotFound"]</div>
}
else
{
    <div class="ui-page-header ui-anim-fade-up">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <a href="/seasons/@Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
            <h3 class="m-0"><i class="bi bi-people me-2"></i>@S["Participants_Title"] — @(_season?.Name ?? "…")</h3>
            @if (_season is not null)
            {
                @* Popisek stavu zůstává ze SeasonStatusExtensions — sdílí ho i další stránky se sezónami. *@
                <span class="badge @_season.Status.Badge()">@_season.Status.Label()</span>
            }
        </div>
        @if (_season is not null)
        {
            @if (CanEdit)
            {
                <button class="btn btn-success btn-sm" @onclick="CloseRegistrationAsync"
                        disabled="@(_busy || _season.Participants.Count < 2)"
                        title="@(_season.Participants.Count < 2 ? S["Participants_NeedTwo"].Value : "")">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-lock-fill me-1"></i>@(_isRaceSport ? S["Participants_CloseRegistration"].Value : S["Participants_CloseAndGenerate"].Value)
                </button>
            }
            else
            {
                <a href="/seasons/@Id/matches" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-controller me-1"></i>@S["Participants_Matches"]
                </a>
            }
        }
    </div>

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2 mt-3 text-muted"><div class="spinner-border spinner-border-sm"></div><span>@S["Loading"]</span></div>
    }
    else if (_season is not null)
    {
        @if (!CanEdit)
        {
            <div class="alert alert-info py-2 small ui-anim-fade-up">
                <i class="bi bi-info-circle me-1"></i>
                @S["Participants_RegistrationClosed"]
            </div>
        }

        <div class="row g-4">
            <!-- Current participants -->
            <div class="@(CanEdit ? "col-md-6" : "col-md-8")">
                <div class="ui-panel ui-anim-fade-up">
                    <div class="ui-panel-header">
                        <span class="ui-panel-title">
                            <i class="bi bi-check-circle text-accent"></i>
                            @(_isTeamSport
                                ? S["Participants_RegisteredTeams", _season.Participants.Count].Value
                                : S["Participants_RegisteredPlayers", _season.Participants.Count].Value)
                        </span>
                    </div>
                    @if (!_season.Participants.Any())
                    {
                        <div class="p-4 text-muted text-center small">@S["Participants_Empty"]</div>
                    }
                    else
                    {
                        <div class="p-2">
                            @{ var i = 1; }
                            @foreach (var p in _season.Participants.OrderBy(p => p.CreatedAt))
                            {
                                <div class="d-flex align-items-center justify-content-between px-2 py-2 border-bottom border-opacity-10">
                                    <span class="small">
                                        <span class="text-muted me-2">@(i++).</span>
                                        <span class="fw-semibold">@p.DisplayName</span>
                                        @if (p.Club is not null)
                                        {
                                            <span class="badge bg-secondary ms-2" title="@p.Club.Name">@(p.Club.ShortName ?? p.Club.Name)</span>
                                        }
                                    </span>
                                    @if (CanEdit)
                                    {
                                        <button class="btn btn-outline-danger btn-sm px-2"
                                                title="@S["Participants_Remove"]" @onclick="() => RemoveAsync(p.Guid)">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (CanEdit)
            {
                <!-- Add participants -->
                <div class="col-md-6">
                    <!-- From club -->
                    @if (_clubs.Any())
                    {
                        <div class="ui-panel ui-anim-fade-up mb-3">
                            <div class="ui-panel-header">
                                <span class="ui-panel-title"><i class="bi bi-shield-fill text-accent"></i> @S["Clubs_AddFromClub"]</span>
                            </div>
                            <div class="p-3">
                                <div class="input-group input-group-sm">
                                    <select class="form-select" @bind="_fromClubId">
                                        <option value="">@S["Clubs_NoClub"]</option>
                                        @foreach (var c in _clubs)
                                        {
                                            <option value="@c.Guid">@c.Name</option>
                                        }
                                    </select>
                                    <button class="btn btn-outline-primary" disabled="@(_busy || _fromClubId is null)" @onclick="AddFromClubAsync">
                                        <i class="bi bi-plus-square me-1"></i>@(_isTeamSport ? S["Clubs_AddClubTeams"].Value : S["Clubs_AddClubRoster"].Value)
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Existing from DB -->
                    <div class="ui-panel ui-anim-fade-up mb-3">
                        <div class="ui-panel-header">
                            <span class="ui-panel-title"><i class="bi bi-search text-accent"></i> @(_isTeamSport ? S["Participants_ExistingTeam"].Value : S["Participants_ExistingPlayer"].Value)</span>
                        </div>
                        <div class="p-3">
                            <input class="form-control form-control-sm mb-2" placeholder="@S["Participants_SearchPlaceholder"]"
                                   @bind="_search" @bind:event="oninput" />
                            @if (!_suggestions.Any())
                            {
                                <div class="text-muted small">
                                    @(string.IsNullOrWhiteSpace(_search) ? S["Participants_AllRegistered"].Value : S["Participants_NothingFound"].Value)
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-1">
                                    @foreach (var c in _suggestions)
                                    {
                                        <button class="btn btn-outline-secondary btn-sm text-start d-flex justify-content-between align-items-center"
                                                disabled="@_busy" @onclick="() => AddExistingAsync(c.Id)">
                                            <span>
                                                <span class="fw-semibold">@c.Name</span>
                                                @if (!string.IsNullOrEmpty(c.Hint))
                                                {
                                                    <span class="text-muted ms-1">(@c.Hint)</span>
                                                }
                                            </span>
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    }
                                    @if (_matchingCount > _suggestions.Count())
                                    {
                                        <div class="text-muted small mt-1">@S["Participants_MoreResults", _matchingCount - _suggestions.Count()]</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- New by name -->
                    <div class="ui-panel ui-anim-fade-up mb-3">
                        <div class="ui-panel-header">
                            <span class="ui-panel-title"><i class="bi bi-person-plus text-accent"></i> @(_isTeamSport ? S["Participants_NewTeam"].Value : S["Participants_NewPlayer"].Value)</span>
                        </div>
                        <div class="p-3">
                            <div class="input-group input-group-sm">
                                <input class="form-control" placeholder="@S["Participants_NamePlaceholder"]" @bind="_newName" @bind:event="oninput"
                                       @onkeydown="OnNewNameKeyDown" />
                                <button class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))"
                                        @onclick="AddNewAsync">
                                    <i class="bi bi-plus me-1"></i>@S["Clubs_Add"]
                                </button>
                            </div>
                            <div class="form-text small">@(_isTeamSport ? S["Participants_ReuseHintTeam"].Value : S["Participants_ReuseHintPlayer"].Value)</div>
                        </div>
                    </div>

                    <!-- Bulk -->
                    <div class="ui-panel ui-anim-fade-up">
                        <div class="ui-panel-header">
                            <span class="ui-panel-title"><i class="bi bi-list-ul text-accent"></i> @S["Participants_Bulk"]</span>
                        </div>
                        <div class="p-3">
                            <textarea class="form-control form-control-sm mb-2" rows="4"
                                      placeholder="@S["Participants_BulkPlaceholder"]" @bind="_bulkNames" @bind:event="oninput"></textarea>
                            <button class="btn btn-outline-primary btn-sm w-100"
                                    disabled="@(_busy || string.IsNullOrWhiteSpace(_bulkNames))" @onclick="AddBulkAsync">
                                <i class="bi bi-plus-square me-1"></i>@S["Participants_AddAll"]
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private const int MaxSuggestions = 8;

    private bool _loading = true, _busy, _isTeamSport;
    // Závodní sport nemá rozpis zápasů — uzavřením registrace se jen přepne stav (viz SeasonScheduleService).
    private bool _isRaceSport;
    private Season? _season;
    private List<(Guid Id, string Name, string? Hint)> _available = new();
    private string _search = "", _newName = "", _bulkNames = "";
    private List<Club> _clubs = new();
    private Guid? _fromClubId;

    private bool CanEdit => _season?.Status.AllowsParticipantChanges() == true;

    private IEnumerable<(Guid Id, string Name, string? Hint)> _matching => string.IsNullOrWhiteSpace(_search)
        ? _available
        : _available.Where(c => c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                             || (c.Hint?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    private int _matchingCount => _matching.Count();
    private IEnumerable<(Guid Id, string Name, string? Hint)> _suggestions => _matching.Take(MaxSuggestions);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _season = await db.Seasons
            .Include(s => s.League).ThenInclude(l => l.Sport)
            .Include(s => s.Participants).ThenInclude(p => p.Player)
            .Include(s => s.Participants).ThenInclude(p => p.Team)
            .Include(s => s.Participants).ThenInclude(p => p.Club)
            .FirstOrDefaultAsync(s => s.Guid == Id);

        if (_season is not null)
        {
            _isTeamSport = _season.League.Sport.ParticipantKind == ParticipantKind.Team;
            _isRaceSport = _season.League.Sport.MatchType == SportMatchType.MultiParticipant;
            _clubs = await db.Clubs.Where(c => c.IsActive).OrderBy(c => c.Name).ToListAsync();

            if (_isTeamSport)
            {
                var taken = _season.Participants.Where(p => p.TeamId.HasValue).Select(p => p.TeamId!.Value).ToHashSet();
                _available = (await db.Teams.Where(t => !taken.Contains(t.Guid)).OrderBy(t => t.Name).ToListAsync())
                    .Select(t => (t.Guid, t.Name, t.ShortName)).ToList();
            }
            else
            {
                var taken = _season.Participants.Where(p => p.PlayerId.HasValue).Select(p => p.PlayerId!.Value).ToHashSet();
                _available = (await db.Players.Where(p => !taken.Contains(p.Guid)).OrderBy(p => p.Name).ToListAsync())
                    .Select(p => (p.Guid, p.Name, p.Nickname)).ToList();
            }
        }
        _loading = false;
    }

    private async Task AddExistingAsync(Guid entityId)
    {
        if (!CanEdit || _busy) return;
        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var season = await LoadEditableSeasonAsync(db);
            if (season is null) return;

            var already = season.Participants.Any(p => _isTeamSport ? p.TeamId == entityId : p.PlayerId == entityId);
            if (!already)
            {
                var clubId = await ResolveClubIdAsync(db, entityId);
                db.SeasonParticipants.Add(_isTeamSport
                    ? new SeasonParticipant { SeasonId = Id, TeamId = entityId, ClubId = clubId }
                    : new SeasonParticipant { SeasonId = Id, PlayerId = entityId, ClubId = clubId });
                PromoteFromDraft(season);
                await db.SaveChangesAsync();
            }
            _search = "";
        }
        finally { _busy = false; }
        await LoadAsync();
    }

    private async Task OnNewNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newName))
            await AddNewAsync();
    }

    private async Task AddNewAsync()
    {
        var name = _newName.Trim();
        var (added, reused, skipped) = await AddByNamesAsync([_newName]);
        if (added + reused > 0)
        {
            Toast.ShowSuccess(S["Participants_Added"], reused > 0
                ? S["Participants_AddedExisting", name]
                : S["Participants_AddedNew", name]);
            _newName = "";
        }
        else if (skipped > 0)
            Toast.ShowWarning(S["Participants_AlreadyTitle"], S["Participants_AlreadyInSeason", name]);
    }

    private async Task AddBulkAsync()
    {
        var lines = _bulkNames.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var (added, reused, skipped) = await AddByNamesAsync(lines);
        var parts = new List<string>();
        if (added   > 0) parts.Add(S["Participants_BulkNew", added]);
        if (reused  > 0) parts.Add(S["Participants_BulkExisting", reused]);
        if (skipped > 0) parts.Add(S["Participants_BulkSkipped", skipped]);
        Toast.ShowSuccess(S["Participants_Done"], parts.Count > 0 ? string.Join(", ", parts) + "." : S["Participants_NothingToAdd"].Value);
        _bulkNames = "";
    }

    /// <summary>
    /// Přidá účastníky podle jména. Existující hráč/tým se stejným jménem (bez ohledu na velikost
    /// písmen) se použije znovu, aby nevznikaly duplicitní záznamy; jinak se založí nový.
    /// </summary>
    private async Task<(int Added, int Reused, int Skipped)> AddByNamesAsync(IEnumerable<string> rawNames)
    {
        var names = rawNames.Select(n => n.Trim()).Where(n => n.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        if (!CanEdit || _busy || names.Count == 0) return (0, 0, 0);

        _busy = true;
        int added = 0, reused = 0, skipped = 0;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var season = await LoadEditableSeasonAsync(db);
            if (season is null) return (0, 0, 0);

            foreach (var name in names)
            {
                var lower = name.ToLower();
                Guid entityId;
                bool existed;

                if (_isTeamSport)
                {
                    var team = await db.Teams.FirstOrDefaultAsync(t => t.Name.ToLower() == lower);
                    existed = team is not null;
                    team ??= db.Teams.Add(new Team { Name = name }).Entity;
                    entityId = team.Guid;
                }
                else
                {
                    var player = await db.Players.FirstOrDefaultAsync(p => p.Name.ToLower() == lower);
                    existed = player is not null;
                    player ??= db.Players.Add(new Player { Name = name }).Entity;
                    entityId = player.Guid;
                }

                if (season.Participants.Any(p => _isTeamSport ? p.TeamId == entityId : p.PlayerId == entityId))
                {
                    skipped++;
                    continue;
                }

                Guid? clubId = existed ? await ResolveClubIdAsync(db, entityId) : null;
                var sp = _isTeamSport
                    ? new SeasonParticipant { SeasonId = Id, TeamId = entityId, ClubId = clubId }
                    : new SeasonParticipant { SeasonId = Id, PlayerId = entityId, ClubId = clubId };
                db.SeasonParticipants.Add(sp);
                season.Participants.Add(sp);

                if (existed) reused++; else added++;
            }

            if (added + reused > 0) PromoteFromDraft(season);
            await db.SaveChangesAsync();
        }
        finally { _busy = false; }

        await LoadAsync();
        return (added, reused, skipped);
    }

    private async Task RemoveAsync(Guid participantId)
    {
        if (!CanEdit) return;
        if (!await Confirm.ShowAsync(S["Participants_Remove"], S["Participants_RemoveConfirm"], S["Clubs_Remove"], S["Clubs_Cancel"]))
            return;

        await using var db = await DbFactory.CreateDbContextAsync();

        // FK Match.HomeParticipant/AwayParticipant je Restrict — účastníka se zápasy nelze smazat.
        var hasMatches = await db.Matches.AnyAsync(m =>
            m.HomeParticipantId == participantId || m.AwayParticipantId == participantId);
        if (hasMatches)
        {
            Toast.ShowError(S["Participants_CannotRemove"], S["Participants_HasMatches"]);
            return;
        }

        var p = await db.SeasonParticipants.FindAsync(participantId);
        if (p is not null) { db.SeasonParticipants.Remove(p); await db.SaveChangesAsync(); }
        Toast.ShowSuccess(S["Participants_Removed"], S["Participants_RemovedMessage"]);
        await LoadAsync();
    }

    private async Task CloseRegistrationAsync()
    {
        if (_season is null || !CanEdit || _season.Participants.Count < 2) return;
        var count = _season.Participants.Count;
        if (!await Confirm.ShowAsync(S["Participants_CloseRegistration"],
                _isRaceSport ? S["Participants_CloseConfirmRace", count] : S["Participants_CloseConfirmGenerate", count],
                S["Participants_CloseButton"], S["Clubs_Cancel"]))
            return;

        _busy = true;
        var result = await Schedule.GenerateAsync(Id);
        _busy = false;

        if (!result.Ok)
        {
            // Text chyby pochází ze SeasonScheduleService — ta zatím hlásí česky.
            Toast.ShowError(S["Participants_CannotGenerate"], result.Error ?? S["Participants_UnknownError"].Value);
            return;
        }
        if (result.MatchCount == 0)
        {
            Toast.ShowSuccess(S["Participants_RegistrationClosedTitle"], S["Participants_RaceInProgress"]);
            Nav.NavigateTo($"/seasons/{Id}");
            return;
        }
        Toast.ShowSuccess(S["Participants_RegistrationClosedTitle"], S["Participants_Generated", result.MatchCount]);
        Nav.NavigateTo($"/seasons/{Id}/matches");
    }

    /// <summary>
    /// Přihlásí oddíl naráz: u týmového sportu jeho týmy, jinak hráče ze soupisky. Účastník dostane
    /// ClubId přímo — v této sezóně hraje za oddíl bez ohledu na pozdější přestupy.
    /// </summary>
    private async Task AddFromClubAsync()
    {
        if (!CanEdit || _busy || _fromClubId is not Guid clubId) return;
        _busy = true;
        var added = 0;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var season = await LoadEditableSeasonAsync(db);
            if (season is null) return;

            if (_isTeamSport)
            {
                var taken = season.Participants.Where(p => p.TeamId.HasValue).Select(p => p.TeamId!.Value).ToHashSet();
                var teamIds = await db.Teams.Where(t => t.ClubId == clubId).Select(t => t.Guid).ToListAsync();
                foreach (var teamId in teamIds.Where(id => !taken.Contains(id)))
                {
                    db.SeasonParticipants.Add(new SeasonParticipant { SeasonId = Id, TeamId = teamId, ClubId = clubId });
                    added++;
                }
            }
            else
            {
                var taken = season.Participants.Where(p => p.PlayerId.HasValue).Select(p => p.PlayerId!.Value).ToHashSet();
                var playerIds = await db.ClubMembers
                    .Where(m => m.ClubId == clubId && m.IsActive)
                    .Select(m => m.PlayerId)
                    .ToListAsync();
                foreach (var playerId in playerIds.Where(id => !taken.Contains(id)))
                {
                    db.SeasonParticipants.Add(new SeasonParticipant { SeasonId = Id, PlayerId = playerId, ClubId = clubId });
                    added++;
                }
            }

            if (added > 0)
            {
                PromoteFromDraft(season);
                await db.SaveChangesAsync();
            }
        }
        finally { _busy = false; }

        Toast.ShowSuccess(S["Clubs_AddedFromClub"], $"{added}");
        await LoadAsync();
    }

    /// <summary>
    /// Oddíl, za který účastník nastupuje. Tým ho má jednoznačně; hráč jen tehdy, když je na soupisce
    /// právě jednoho aktivního oddílu — při víc oddílech nelze hádat a přiřadí se přes panel „Z oddílu“.
    /// </summary>
    private async Task<Guid?> ResolveClubIdAsync(AppDbContext db, Guid entityId)
    {
        if (_isTeamSport)
            return await db.Teams.Where(t => t.Guid == entityId).Select(t => t.ClubId).FirstOrDefaultAsync();

        var clubs = await db.ClubMembers
            .Where(m => m.PlayerId == entityId && m.IsActive && m.Club.IsActive)
            .Select(m => m.ClubId)
            .Distinct()
            .Take(2)
            .ToListAsync();
        return clubs.Count == 1 ? clubs[0] : null;
    }

    /// <summary>Načte sezónu i s účastníky a ověří, že ji lze ještě měnit (stav mohl změnit jiný admin).</summary>
    private async Task<Season?> LoadEditableSeasonAsync(AppDbContext db)
    {
        var season = await db.Seasons.Include(s => s.Participants).FirstOrDefaultAsync(s => s.Guid == Id);
        if (season is null || !season.Status.AllowsParticipantChanges())
        {
            Toast.ShowError(S["Participants_CannotEdit"], S["Participants_SeasonClosed"]);
            return null;
        }
        return season;
    }

    /// <summary>Prvním přidaným účastníkem se sezóna z Návrhu automaticky přepne do Registrace.</summary>
    private static void PromoteFromDraft(Season season)
    {
        if (season.Status != SeasonStatus.Draft) return;
        season.Status    = SeasonStatus.Registration;
        season.UpdatedAt = DateTimeOffset.UtcNow;
    }
}
