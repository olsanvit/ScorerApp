@page "/admin"
@using System.Security.Claims
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IStringLocalizer<SharedResource> S
@inject ScorerApp.Domain.Services.SportRatingService Ratings
@inject ScorerApp.Domain.Services.DemoDataService Demo
@inject ConfirmService Confirm
@inject AuthenticationStateProvider AuthState

<PageTitle>@S["Admin"] — ScorerApp</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <h3><i class="bi bi-shield-lock"></i> @S["Admin"]</h3>
</div>

<div class="row g-3 ui-anim-fade-up">
    <div class="col-6 col-md-4">
        <a href="/admin/leagues/create" class="text-decoration-none">
            <div class="ui-panel p-4 text-center" style="cursor:pointer">
                <i class="bi bi-trophy-fill fs-2 text-accent d-block mb-2"></i>
                <div class="fw-semibold">@S["NewLeague"]</div>
                <div class="text-muted small">@S["NewLeagueHint"]</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a href="/admin/seasons/create" class="text-decoration-none">
            <div class="ui-panel p-4 text-center" style="cursor:pointer">
                <i class="bi bi-calendar3 fs-2 text-accent d-block mb-2"></i>
                <div class="fw-semibold">@S["NewSeason"]</div>
                <div class="text-muted small">@S["NewSeasonHint"]</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a href="/admin/players/create" class="text-decoration-none">
            <div class="ui-panel p-4 text-center" style="cursor:pointer">
                <i class="bi bi-person-plus fs-2 text-accent d-block mb-2"></i>
                <div class="fw-semibold">@S["NewPlayer"]</div>
                <div class="text-muted small">@S["NewPlayerHint"]</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a href="/admin/teams/create" class="text-decoration-none">
            <div class="ui-panel p-4 text-center" style="cursor:pointer">
                <i class="bi bi-shield-plus fs-2 text-accent d-block mb-2"></i>
                <div class="fw-semibold">@S["NewTeam"]</div>
                <div class="text-muted small">@S["NewTeamHint"]</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a href="/leagues" class="text-decoration-none">
            <div class="ui-panel p-4 text-center" style="cursor:pointer">
                <i class="bi bi-list-ul fs-2 text-accent d-block mb-2"></i>
                <div class="fw-semibold">@S["ManageLeagues"]</div>
                <div class="text-muted small">@S["ManageLeaguesHint"]</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a href="/admin/users" class="text-decoration-none">
            <div class="ui-panel p-4 text-center" style="cursor:pointer">
                <i class="bi bi-people-fill fs-2 text-accent d-block mb-2"></i>
                <div class="fw-semibold">@S["AdminUsers_Title"]</div>
                <div class="text-muted small">@S["AdminUsers_Hint"]</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a href="/admin/sports" class="text-decoration-none">
            <div class="ui-panel p-4 text-center" style="cursor:pointer">
                <i class="bi bi-activity fs-2 text-accent d-block mb-2"></i>
                <div class="fw-semibold">@S["Sports"]</div>
                <div class="text-muted small">@S["SportsHint"]</div>
            </div>
        </a>
    </div>
</div>

<div class="ui-panel p-4 mt-4 ui-anim-fade-up">
    <div class="fw-semibold mb-1"><i class="bi bi-arrow-repeat text-accent"></i> @S["Maintenance"]</div>
    <div class="text-muted small mb-3">@S["RecomputeRatingsHint"]</div>

    <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="RecomputeAsync">
        @if (_busy)
        {
            <span class="spinner-border spinner-border-sm me-2"></span>
            @S["RecomputeRunning"]
        }
        else
        {
            @S["RecomputeRatings"]
        }
    </button>

    @if (_result is not null)
    {
        <div class="alert @(_failed ? "alert-danger" : "alert-success") mt-3 mb-0 py-2">@_result</div>
    }
</div>

<div class="ui-panel p-4 mt-4 ui-anim-fade-up">
    <div class="fw-semibold mb-1"><i class="bi bi-magic text-accent"></i> @S["Demo_Title"]</div>
    <div class="text-muted small mb-3">@S["Demo_Hint"]</div>

    <div class="d-flex flex-wrap gap-2">
        @if (_demoExists)
        {
            <button class="btn btn-outline-danger" disabled="@_demoBusy" @onclick="RemoveDemoAsync">
                <i class="bi bi-trash me-1"></i>@S["Demo_Remove"]
            </button>
        }
        else
        {
            <button class="btn btn-outline-secondary" disabled="@_demoBusy" @onclick="() => CreateDemoAsync(dryRun: true)">
                <i class="bi bi-eye me-1"></i>@S["Demo_DryRun"]
            </button>
            <button class="btn btn-primary" disabled="@_demoBusy" @onclick="() => CreateDemoAsync(dryRun: false)">
                <i class="bi bi-plus-circle me-1"></i>@S["Demo_Create"]
            </button>
        }
        @if (_demoBusy)
        {
            <span class="spinner-border spinner-border-sm align-self-center"></span>
        }
    </div>

    @if (_demoResult is not null)
    {
        <div class="alert @(_demoFailed ? "alert-danger" : "alert-success") mt-3 mb-0 py-2">@_demoResult</div>
    }
</div>

@code {
    private bool _demoExists;
    private bool _demoBusy;
    private bool _demoFailed;
    private string? _demoResult;

    protected override async Task OnInitializedAsync()
    {
        try { _demoExists = await Demo.ExistsAsync(); }
        catch (Exception) { _demoExists = false; }
    }

    private async Task CreateDemoAsync(bool dryRun)
    {
        if (!dryRun && !await Confirm.ShowAsync(S["Demo_Create"], S["Demo_CreateConfirm"], S["Demo_Create"], S["Cancel"]))
            return;

        _demoBusy = true;
        _demoResult = null;
        try
        {
            var user = (await AuthState.GetAuthenticationStateAsync()).User;
            var adminId = user.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier) ?? "";
            var r = await Demo.CreateAsync(adminId, dryRun);
            _demoFailed = !r.Ok;
            _demoResult = !r.Ok
                ? S[r.Error!]
                : string.Format(S[dryRun ? "Demo_DryRunDone" : "Demo_Created"], r.Rows)
                  + (r.TestUserPaired ? "" : " " + S["Demo_NoTestUser"]);
            if (r.Ok && !dryRun) _demoExists = true;
        }
        catch (Exception ex)
        {
            _demoFailed = true;
            _demoResult = $"{S["Demo_Failed"]}: {ex.Message}";
        }
        finally { _demoBusy = false; }
    }

    private async Task RemoveDemoAsync()
    {
        if (!await Confirm.ShowAsync(S["Demo_Remove"], S["Demo_RemoveConfirm"], S["Demo_Remove"], S["Cancel"]))
            return;

        _demoBusy = true;
        _demoResult = null;
        try
        {
            var n = await Demo.RemoveAsync();
            _demoFailed = false;
            _demoResult = string.Format(S["Demo_Removed"], n);
            _demoExists = false;
        }
        catch (Exception ex)
        {
            _demoFailed = true;
            _demoResult = $"{S["Demo_Failed"]}: {ex.Message}";
        }
        finally { _demoBusy = false; }
    }

    private bool _busy;
    private bool _failed;
    private string? _result;

    /// <summary>
    /// Ruční přepočet je potřeba jen po opravě staršího výsledku — rating se počítá přehráním celé
    /// historie, takže po zpětné změně by jinak zůstal na čísle spočítaném ze starých dat.
    /// </summary>
    private async Task RecomputeAsync()
    {
        _busy = true;
        _result = null;

        try
        {
            await Ratings.RecomputeAllAsync();
            _failed = false;
            _result = S["RecomputeDone"];
        }
        catch (Exception ex)
        {
            _failed = true;
            _result = $"{S["RecomputeFailed"]}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
