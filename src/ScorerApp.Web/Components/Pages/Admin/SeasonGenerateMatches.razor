@page "/admin/seasons/{Id:guid}/generate"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ScorerApp.Domain.Services.SeasonScheduleService Schedule
@inject ScorerApp.Domain.Services.SeasonFormatService Formats
@inject SharedServices.ToastService Toast
@inject NavigationManager Nav

<PageTitle>Generovat zápasy — ScorerApp</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <div class="d-flex align-items-center gap-3">
        <a href="/seasons/@Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <h3 class="m-0"><i class="bi bi-magic me-2"></i>Generovat zápasy</h3>
    </div>
</div>

@if (_loading)
{
    <div class="d-flex align-items-center gap-2 mt-3 text-muted"><div class="spinner-border spinner-border-sm"></div><span>Načítám…</span></div>
}
else if (_season is null)
{
    <div class="alert alert-warning">Sezóna nebyla nalezena.</div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="ui-panel ui-anim-fade-up p-4">
                <h5 class="mb-3">@_season.Name</h5>

                <div class="mb-3">
                    <div class="text-muted small mb-1">Účastníci</div>
                    <div class="fw-semibold fs-5">@_season.Participants.Count</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small mb-1">Formát</div>
                    <div class="fw-semibold">@Formats.Describe(Formats.Resolve(_season))</div>
                </div>
                @if (_phase is not null && _phase.AnythingGenerated)
                {
                    <div class="mb-3">
                        <div class="text-muted small mb-1">Aktuální fáze</div>
                        <div class="fw-semibold">
                            @(_phase.CurrentModule is null
                                ? "—"
                                : ScorerApp.Domain.Services.SeasonFormatService.Describe(_phase.CurrentModule))
                            @if (_phase.CurrentComplete)
                            {
                                <span class="badge bg-success ms-1">dohráno</span>
                            }
                        </div>
                    </div>
                }
                <div class="mb-4">
                    <div class="text-muted small mb-1">Počet zápasů které se vygenerují</div>
                    <div class="fw-bold fs-4 text-accent">@_expectedMatches</div>
                </div>

                @if (_season.Matches.Any())
                {
                    <div class="alert alert-warning py-2 small mb-3">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Sezóna již má @_season.Matches.Count zápasů. Pokud žádný nemá výsledek, budou nahrazeny novým rozpisem; jinak generování zablokuje odehraný zápas.
                    </div>
                }

                @* Navazující fáze (playoff, další kolo Swissu) jde generovat až po dohrání té aktuální,
                   protože nasazení se bere z její tabulky. *@
                @if (_phase is not null && _phase.AnythingGenerated && (_phase.NextModule is not null
                     || _phase.CurrentModule?.Type == SeasonModuleType.Swiss))
                {
                    <button class="btn btn-primary w-100 mb-3" @onclick="GenerateNextPhaseAsync"
                            disabled="@(_generating || !_phase.CurrentComplete)">
                        @if (_generating)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-arrow-right-circle me-1"></i>Generovat další fázi
                    </button>
                    @if (!_phase.CurrentComplete)
                    {
                        <div class="text-muted small mb-3">Aktuální fáze ještě není dohraná.</div>
                    }
                }

                @if (_season.Participants.Count < 2)
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        Potřebuješ alespoň 2 účastníky.
                        <a href="/admin/seasons/@Id/participants">Přidat účastníky.</a>
                    </div>
                }
                else
                {
                    <button class="btn btn-success w-100" @onclick="GenerateAsync" disabled="@_generating">
                        @if (_generating)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-magic me-1"></i>Generovat @_expectedMatches zápasů
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private bool _loading = true, _generating;
    private Season? _season;
    private ScorerApp.Domain.Services.SeasonPhaseStatus? _phase;

    private int _expectedMatches => _season is null ? 0 :
        _season.Format == SeasonFormat.DoubleRoundRobin
            ? _season.Participants.Count * (_season.Participants.Count - 1)
            : _season.Participants.Count * (_season.Participants.Count - 1) / 2;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _season = await db.Seasons
            .Include(s => s.Participants)
            .Include(s => s.Matches)
            .FirstOrDefaultAsync(s => s.Guid == Id);
        if (_season is not null) _phase = await Schedule.GetPhaseStatusAsync(Id);
        _loading = false;
    }

    private async Task GenerateAsync()
    {
        if (_season is null || _season.Participants.Count < 2) return;
        _generating = true;

        var result = await Schedule.GenerateAsync(Id);
        _generating = false;

        if (!result.Ok)
        {
            Toast.ShowError("Nelze vygenerovat", result.Error ?? "Neznámá chyba.");
            return;
        }
        if (result.MatchCount == 0)
        {
            // Závodní sport — žádné zápasy, jen přepnutí stavu (viz SeasonScheduleService).
            Toast.ShowSuccess("Hotovo", "Sezóna probíhá — výsledky zadávej přes závody.");
            Nav.NavigateTo($"/seasons/{Id}");
            return;
        }
        Toast.ShowSuccess("Vygenerováno", $"{result.MatchCount} zápasů bylo přidáno. Sezóna nyní probíhá.");
        Nav.NavigateTo($"/seasons/{Id}/matches");
    }

    private async Task GenerateNextPhaseAsync()
    {
        _generating = true;
        var result = await Schedule.GenerateNextPhaseAsync(Id);
        _generating = false;

        if (!result.Ok)
        {
            Toast.ShowError("Nelze vygenerovat", result.Error ?? "Neznámá chyba.");
            return;
        }
        Toast.ShowSuccess("Hotovo", result.MatchCount > 0
            ? $"Vygenerováno {result.MatchCount} zápasů."
            : "Pavouk byl sestaven.");
        Nav.NavigateTo($"/seasons/{Id}");
    }
}
