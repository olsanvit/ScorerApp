@page "/join"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits ClubPageBase
@inject InvitationService Invitations

<PageTitle>@S["Clubs_JoinTitle"] — ScorerApp</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <h3><i class="bi bi-box-arrow-in-right"></i> @S["Clubs_JoinTitle"]</h3>
</div>

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="ui-panel ui-anim-fade-up p-4">
            @if (_joined is not null)
            {
                <div class="alert alert-success mb-3">
                    <i class="bi bi-check-circle me-1"></i>@S["Clubs_JoinedClub"] <strong>@_joined.Name</strong>.
                </div>
                <a href="/clubs/@_joined.Guid" class="btn btn-primary w-100">@S["Clubs_Detail"]</a>
            }
            else
            {
                <p class="text-muted small">@S["Clubs_JoinHint"]</p>
                <input class="form-control form-control-lg text-center text-uppercase mb-3" style="letter-spacing:.2em"
                       placeholder="ABC12345" maxlength="16" @bind="_code" @bind:event="oninput" @onkeydown="OnKeyDown" />
                @if (_failed)
                {
                    <div class="alert alert-danger py-2 small">@S["Clubs_JoinFailed"]</div>
                }
                <button class="btn btn-primary w-100" disabled="@(_busy || string.IsNullOrWhiteSpace(_code))" @onclick="JoinAsync">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    @S["Clubs_Join"]
                </button>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Code { get; set; }

    private string _code = "";
    private bool _busy, _failed;
    private Club? _joined;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        // Odkaz /join?code=… vyplní kód rovnou — správce ho může poslat jako odkaz místo opisování.
        _code = Code ?? "";
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_code))
            await JoinAsync();
    }

    private async Task JoinAsync()
    {
        if (_busy) return;
        _busy = true;
        _failed = false;
        _joined = await Invitations.JoinByCodeAsync(_code, UserId);
        _failed = _joined is null;
        _busy = false;
    }
}
