@page "/"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits ClubPageBase
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ClubService Clubs

<PageTitle>@S["Home_Dashboard"] — ScorerApp</PageTitle>

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-4">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">@S["Home_Loading"]</span>
    </div>
}
else
{
    <div class="ui-page-header ui-anim-fade-up">
        <h3><i class="bi bi-trophy-fill"></i> @S["Home_Dashboard"]</h3>
    </div>

    <div class="row g-3 mb-4 ui-anim-fade-up dash-stats">
        <div class="col-6 col-lg-3">
            <UiStats Label="@S["Home_Leagues"]" Value="@_leagues.ToString()" Icon="bi-trophy" IconBgClass="icon-accent" />
        </div>
        <div class="col-6 col-lg-3">
            <UiStats Label="@S["Home_ActiveSeasons"]" Value="@_activeSeasonsCount.ToString()" Icon="bi-calendar3" IconBgClass="icon-emerald" />
        </div>
        <div class="col-6 col-lg-3">
            <UiStats Label="@S["Home_Players"]" Value="@_players.ToString()" Icon="bi-people" IconBgClass="icon-amber" />
        </div>
        <div class="col-6 col-lg-3">
            <UiStats Label="@S["Home_PlayedMatches"]" Value="@_playedMatches.ToString()" Icon="bi-controller" IconBgClass="icon-purple" />
        </div>
    </div>

    @if (_myClubs.Any())
    {
        <div class="ui-panel ui-anim-fade-up mb-4">
            <div class="ui-panel-header">
                <span class="ui-panel-title"><i class="bi bi-shield-fill text-accent"></i> @S["Home_MyClubs"]</span>
                @* Chat a oběžníky s počtem nepřečtených jsou v horní liště, viditelné odevšad —
                   tady by se na mobilu jen zalamovaly pod nadpis a říkaly totéž podruhé. *@
                <a href="/clubs" class="btn btn-outline-secondary btn-sm">@S["Home_AllClubs"]</a>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var c in _myClubs.Take(MaxClubs))
                {
                    <a href="/clubs/@c.Id" class="list-group-item list-group-item-action bg-transparent d-flex justify-content-between align-items-center">
                        <span><span class="fw-semibold">@c.Name</span> <span class="text-muted small">· @c.OrganizationName</span></span>
                        @if (c.IsParent)
                        {
                            <span class="badge bg-info text-dark">@S["Home_AsParent"]</span>
                        }
                    </a>
                }
            </div>
            @if (_myClubs.Count > MaxClubs)
            {
                <div class="p-2 text-end"><a href="/clubs" class="small">@S["Home_AllClubs"]</a></div>
            }
        </div>
    }

    <div class="ui-panel ui-anim-fade-up mb-4">
        <div class="ui-panel-header">
            <span class="ui-panel-title"><i class="bi bi-grid text-accent"></i> @S["Home_Sports"]</span>
            <a href="/leagues" class="btn btn-outline-secondary btn-sm">@S["Home_AllLeagues"]</a>
        </div>
        @if (!_sports.Any())
        {
            <div class="p-4 text-center text-muted">
                <i class="bi bi-emoji-smile fs-3 d-block mb-2"></i>
                <div>@S["Home_NoSports"]</div>
                @if (IsSiteAdmin)
                {
                    <a href="/admin/sports" class="btn btn-outline-primary btn-sm mt-2">
                        <i class="bi bi-plus me-1"></i>@S["Home_AddSport"]
                    </a>
                }
            </div>
        }
        else
        {
            <div class="p-3">
                <div class="row g-2">
                    @foreach (var s in _sports)
                    {
                        <div class="col-6 col-md-3">
                            <a href="/leagues?sport=@s.Guid" class="text-decoration-none">
                                <div class="ui-panel text-center p-3 h-100 d-flex flex-column justify-content-center" style="cursor:pointer">
                                    <div class="fs-2 mb-1"><i class="bi @s.Icon text-accent"></i></div>
                                    <div class="fw-semibold small">@s.Name</div>
                                    <div class="text-muted" style="font-size:.75rem">@S["Home_LeagueCount", s.Leagues.Count]</div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="ui-panel ui-anim-fade-up">
        <div class="ui-panel-header">
            <span class="ui-panel-title"><i class="bi bi-calendar3-event text-accent"></i> @S["Home_ActiveSeasons"]</span>
            <a href="/seasons" class="btn btn-outline-secondary btn-sm">@S["Home_AllSeasons"]</a>
        </div>
        @if (_activeSeasons.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                <i class="bi bi-calendar-x fs-3 d-block mb-2"></i>
                @S["Home_NoActiveSeasons"] <a href="/seasons">@S["Home_GoToSeasons"]</a>
            </div>
        }
        else
        {
            <div class="table-responsive d-none d-sm-block">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr><th>@S["Home_Season"]</th><th>@S["Home_League"]</th><th>@S["Home_Sport"]</th><th class="text-center">@S["Home_Matches"]</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _activeSeasons)
                        {
                            <tr>
                                <td class="fw-semibold"><a href="/seasons/@s.Guid" class="text-decoration-none">@s.Name</a></td>
                                <td class="text-muted small"><a href="/leagues/@s.League.Guid" class="text-decoration-none text-muted">@s.League.Name</a></td>
                                <td class="text-muted small">@s.League.Sport.Name</td>
                                <td class="text-center text-muted small">@_counts.GetValueOrDefault(s.Guid).Matches</td>
                                <td><a href="/seasons/@s.Guid/matches" class="btn btn-outline-secondary btn-sm">@S["Home_Matches"]</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Na mobilu se pět sloupců nevejde — stejná data jako karta, celá je odkazem na sezónu. *@
            <div class="d-sm-none match-cards">
                @foreach (var s in _activeSeasons)
                {
                    <a href="/seasons/@s.Guid" class="match-card d-flex justify-content-between align-items-center gap-2 text-decoration-none">
                        <span>
                            <span class="fw-semibold d-block">@s.Name</span>
                            <span class="text-muted small">@s.League.Name · @s.League.Sport.Name</span>
                        </span>
                        <span class="text-muted small text-nowrap">
                            <i class="bi bi-controller me-1"></i>@_counts.GetValueOrDefault(s.Guid).Matches
                        </span>
                    </a>
                }
            </div>
        }
    </div>
}

@code {
    private const int MaxClubs = 6;

    private bool _loading = true;
    private int _leagues, _players, _playedMatches, _activeSeasonsCount;
    private List<Sport> _sports = new();
    private List<Season> _activeSeasons = new();
    private Dictionary<Guid, ScorerApp.Domain.Services.SeasonCount> _counts = new();
    private List<MyClubRow> _myClubs = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            _leagues            = await db.Leagues.CountAsync();
            _players            = await db.Players.CountAsync();
            _playedMatches      = await db.Matches.CountAsync(m => m.Status == MatchStatus.Played);
            _activeSeasonsCount = await db.Seasons.CountAsync(s => s.Status == SeasonStatus.InProgress);

            _sports = await db.Sports.Include(s => s.Leagues).OrderBy(s => s.Name).ToListAsync();

            _activeSeasons = await db.Seasons
                .Where(s => s.Status == SeasonStatus.InProgress)
                .Include(s => s.League).ThenInclude(l => l.Sport)
                .OrderBy(s => s.Name).Take(10).ToListAsync();
            _counts = await ScorerApp.Domain.Services.SeasonCounts.LoadAsync(db, _activeSeasons.Select(s => s.Guid).ToList());
        }

        // Nepřečtené zprávy počítá horní lišta, tady by to byly dva dotazy navíc pro nic.
        _myClubs = await Clubs.GetMyClubsAsync(UserId, IsSiteAdmin);

        _loading = false;
    }
}
