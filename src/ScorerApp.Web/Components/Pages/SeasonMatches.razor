@* AUDIT:FIXED|byl: SaveScoreAsync bez _isAdmin kontroly; přidáno *@
@page "/seasons/{Id:guid}/matches"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject SharedServices.ToastService Toast
@inject ScorerApp.Domain.Services.SeasonScheduleService Schedule
@inject AuthenticationStateProvider Auth
@inject IStringLocalizer<SharedResource> S

<PageTitle>@S["SeasonMatches_Title"] — ScorerApp</PageTitle>

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-4">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">@S["Loading"]</span>
    </div>
}
else if (_season is null)
{
    <div class="alert alert-warning mt-4">@S["SeasonMatches_SeasonNotFound"]</div>
}
else
{
    <div class="ui-page-header ui-anim-fade-up">
        <div class="d-flex align-items-center gap-3">
            <a href="/seasons/@_season.Guid" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
            <h3 class="m-0"><i class="bi bi-controller me-2"></i>@_season.Name — @S["SeasonMatches_Title"]</h3>
        </div>
        @if (_isAdmin && !_season.Matches.Any())
        {
            <a href="/admin/seasons/@_season.Guid/generate" class="btn btn-primary btn-sm">
                <i class="bi bi-magic me-1"></i>@S["SeasonMatches_Generate"]
            </a>
        }
    </div>

    @if (!_season.Matches.Any())
    {
        <div class="ui-panel ui-anim-fade-up p-4 text-center text-muted">
            <i class="bi bi-controller fs-3 d-block mb-2"></i>
            @S["SeasonMatches_Empty"]
            @if (_isAdmin)
            {
                <a href="/admin/seasons/@_season.Guid/generate">@S["SeasonMatches_GenerateRounds"]</a>
            }
        </div>
    }
    else
    {
        @* Seskupení musí být podle fáze i skupiny — playoff začíná znovu od kola 1
           a bez rozlišení by splynulo s ligovými koly. *@
        @foreach (var round in _season.Matches
            .GroupBy(m => (m.Stage, m.GroupIndex, m.Round))
            .OrderBy(g => g.Key.Stage).ThenBy(g => g.Key.Round).ThenBy(g => g.Key.GroupIndex))
        {
            <div class="ui-panel ui-anim-fade-up mb-3">
                <div class="ui-panel-header">
                    <span class="ui-panel-title"><i class="bi bi-circle-fill text-accent me-1" style="font-size:.5rem;vertical-align:middle"></i> @RoundLabel(round.Key.Stage, round.Key.GroupIndex, round.Key.Round)</span>
                    <span class="text-muted small">@(S["SeasonMatches_PlayedOf", round.Count(m => m.Status == MatchStatus.Played), round.Count()])</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <tbody>
                            @foreach (var m in round.OrderBy(m => m.MatchDate))
                            {
                                <tr>
                                    <td class="text-muted small" style="width:80px">
                                        @(m.MatchDate?.ToString("dd.MM") ?? "—")
                                    </td>
                                    <td class="fw-semibold text-end" style="width:35%">@m.HomeParticipant.DisplayName</td>
                                    <td class="text-center" style="width:100px">
                                        @if (m.Status == MatchStatus.Played)
                                        {
                                            <span class="badge @ScoreBadge(m) px-3">@m.HomeScore : @m.AwayScore</span>
                                        }
                                        else if (m.Status == MatchStatus.Cancelled)
                                        {
                                            <span class="badge bg-danger">@S["SeasonMatches_Cancelled"]</span>
                                        }
                                        else
                                        {
                                            @if (_isAdmin)
                                            {
                                                <!-- Quick score entry — only Admin -->
                                                <div class="d-flex align-items-center gap-1 justify-content-center">
                                                    <input type="number" class="form-control form-control-sm text-center p-1"
                                                           style="width:42px;background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                                           min="0"
                                                           @bind="_quickScores[m.Guid].Home" />
                                                    <span class="text-muted">:</span>
                                                    <input type="number" class="form-control form-control-sm text-center p-1"
                                                           style="width:42px;background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                                           min="0"
                                                           @bind="_quickScores[m.Guid].Away" />
                                                    <button class="btn btn-success btn-sm px-2" title="@S["Save"]"
                                                            @onclick="() => SaveScoreAsync(m.Guid)">
                                                        <i class="bi bi-check"></i>
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">vs</span>
                                            }
                                        }
                                    </td>
                                    <td class="fw-semibold" style="width:35%">@m.AwayParticipant.DisplayName</td>
                                    <td class="text-end" style="width:60px">
                                        <a href="/matches/@m.Guid" class="btn btn-outline-secondary btn-sm px-2" title="@S["SeasonMatches_MatchDetail"]">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}

@code {
    [Parameter] public Guid Id { get; set; }
    private bool _loading = true;
    private bool _isAdmin;
    private Season? _season;
    private Dictionary<Guid, QuickScore> _quickScores = new();
    private sealed class QuickScore { public int? Home { get; set; } public int? Away { get; set; } }

    /// <summary>Popisek skupiny zápasů — liga má prostá kola, skupiny a playoff vlastní názvy.</summary>
    private string RoundLabel(MatchStage stage, int? groupIndex, int round) => stage switch
    {
        MatchStage.Group   => S["SeasonMatches_GroupRound", (char)('A' + (groupIndex ?? 1) - 1), round],
        MatchStage.Swiss   => S["SeasonMatches_SwissRound", round],
        MatchStage.Playoff => ScorerApp.Domain.Services.PlayoffService.RoundName(round, _playoffRounds, S),
        _                  => S["SeasonMatches_Round", round]
    };

    /// <summary>Počet playoff kol je potřeba pro pojmenování (finále/semifinále/…).</summary>
    private int _playoffRounds =>
        _season?.Matches.Where(m => m.Stage == MatchStage.Playoff)
                        .Select(m => m.Round).DefaultIfEmpty(0).Max() ?? 0;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = (await Auth.GetAuthenticationStateAsync()).User.IsInRole("Admin");
        await using var db = await DbFactory.CreateDbContextAsync();
        _season = await db.Seasons
            .Include(s => s.League)
            .Include(s => s.Matches).ThenInclude(m => m.HomeParticipant).ThenInclude(p => p.Player)
            .Include(s => s.Matches).ThenInclude(m => m.HomeParticipant).ThenInclude(p => p.Team)
            .Include(s => s.Matches).ThenInclude(m => m.AwayParticipant).ThenInclude(p => p.Player)
            .Include(s => s.Matches).ThenInclude(m => m.AwayParticipant).ThenInclude(p => p.Team)
            .FirstOrDefaultAsync(s => s.Guid == Id);

        if (_season is not null)
            foreach (var m in _season.Matches)
                _quickScores[m.Guid] = new QuickScore();

        _loading = false;
    }

    private async Task SaveScoreAsync(Guid matchId)
    {
        if (!_isAdmin) return;
        if (!_quickScores.TryGetValue(matchId, out var score)) return;
        if (score.Home is null || score.Away is null)
        {
            Toast.ShowWarning(S["SeasonMatches_MissingScore"].Value, S["SeasonMatches_MissingScoreHint"].Value);
            return;
        }
        int home = score.Home.Value, away = score.Away.Value;

        await using var db = await DbFactory.CreateDbContextAsync();

        var m = await db.Matches
            .Include(x => x.Season)
            .FirstOrDefaultAsync(x => x.Guid == matchId);
        if (m is null) return;

        m.HomeScore = home;
        m.AwayScore = away;
        m.Status    = MatchStatus.Played;
        m.UpdatedAt = DateTimeOffset.UtcNow;
        await db.SaveChangesAsync();

        // Sezónní ELO, playoff postup a trvalý rating sportu — společná logika pro všechna
        // místa, kde se ukládá výsledek. Musí běžet až po SaveChanges výše, protože čte
        // nový výsledek z databáze.
        var followUp = await Schedule.AfterResultSavedAsync(matchId);
        if (!followUp.Ok) Toast.ShowWarning(S["SeasonMatches_Warning"].Value, followUp.Error!);

        // Refresh in-memory
        var updated = _season!.Matches.First(x => x.Guid == matchId);
        updated.HomeScore = home;
        updated.AwayScore = away;
        updated.Status    = MatchStatus.Played;
        Toast.ShowSuccess(S["SeasonMatches_Saved"].Value, S["SeasonMatches_ResultSaved", home, away].Value);
        StateHasChanged();
    }

    private static string ScoreBadge(Match m)
    {
        if (m.HomeScore > m.AwayScore) return "bg-success";
        if (m.HomeScore < m.AwayScore) return "bg-danger";
        return "bg-secondary";
    }
}
