@page "/teams/{Id:guid}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider Auth
@inject SharedServices.ToastService Toast
@inject ConfirmService Confirm
@inject IStringLocalizer<SharedResource> S

<PageTitle>@(_team?.Name ?? S["Team"]) — ScorerApp</PageTitle>

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-4">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">@S["Loading"]</span>
    </div>
}
else if (_team is null)
{
    <div class="alert alert-warning mt-4">@S["Team_NotFound"]</div>
}
else
{
    <div class="ui-page-header ui-anim-fade-up">
        <div class="d-flex align-items-center gap-3">
            <a href="/teams" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
            <h3 class="m-0">
                @if (!string.IsNullOrEmpty(_team.Color))
                {
                    <span class="me-2" style="display:inline-block;width:14px;height:14px;border-radius:50%;background:@_team.Color;vertical-align:middle"></span>
                }
                @_team.Name
            </h3>
            @if (!string.IsNullOrEmpty(_team.ShortName))
            {
                <span class="badge bg-secondary">@_team.ShortName</span>
            }
        </div>
        @if (_isAdmin)
        {
            <a href="/admin/teams/@_team.Guid/edit" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-pencil me-1"></i>@S["TeamDetail_Edit"]
            </a>
        }
    </div>

    <div class="row g-4">
        <!-- Roster -->
        <div class="col-md-4">
            <div class="ui-panel ui-anim-fade-up">
                <div class="ui-panel-header">
                    <span class="ui-panel-title"><i class="bi bi-people text-accent"></i> @S["TeamDetail_Roster"]</span>
                    @if (_isAdmin)
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleAddPlayer">
                            <i class="bi bi-plus me-1"></i>@S["TeamDetail_Add"]
                        </button>
                    }
                </div>

                @if (_isAdmin && _showAddPlayer)
                {
                    <div class="p-3 border-bottom border-opacity-10">
                        <div class="mb-2">
                            <label class="form-label small text-muted">@S["Player"]</label>
                            <select class="form-select form-select-sm"
                                    style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                    @bind="_addPlayerGuid">
                                <option value="">@S["TeamDetail_SelectPlayer"]</option>
                                @foreach (var p in _availablePlayers)
                                {
                                    <option value="@p.Guid">@p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-muted">@S["TeamDetail_PositionOptional"]</label>
                            <input class="form-control form-control-sm"
                                   style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:var(--ui-text-1)"
                                   @bind="_addPlayerPosition" placeholder="@S["TeamDetail_PositionPlaceholder"]" />
                        </div>
                        <button class="btn btn-primary btn-sm w-100" @onclick="AddPlayerAsync">@S["TeamDetail_AddPlayer"]</button>
                    </div>
                }

                @if (!_team.TeamPlayers.Any())
                {
                    <div class="p-4 text-muted text-center small">@S["TeamDetail_NoPlayers"]</div>
                }
                else
                {
                    <div class="p-3">
                        @foreach (var tp in _team.TeamPlayers.OrderBy(tp => tp.Player.Name))
                        {
                            <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-opacity-10">
                                <div>
                                    <a href="/players/@tp.Player.Guid" class="text-decoration-none fw-semibold">@tp.Player.Name</a>
                                    @if (!string.IsNullOrEmpty(tp.Position))
                                    {
                                        <span class="badge bg-secondary ms-2 small">@tp.Position</span>
                                    }
                                </div>
                                @if (_isAdmin)
                                {
                                    <button class="btn btn-outline-danger btn-sm px-2"
                                            title="@S["TeamDetail_RemovePlayer"]" @onclick="() => RemovePlayerAsync(tp.Guid)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Season history -->
        <div class="col-md-8">
            <div class="ui-panel ui-anim-fade-up">
                <div class="ui-panel-header">
                    <span class="ui-panel-title"><i class="bi bi-calendar3 text-accent"></i> @S["TeamDetail_Seasons"]</span>
                </div>
                @if (!_seasonParticipations.Any())
                {
                    <div class="p-4 text-muted text-center">@S["TeamDetail_NoSeasons"]</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr><th>@S["TeamDetail_Season"]</th><th>@S["TeamDetail_League"]</th><th>@S["TeamDetail_Status"]</th><th class="text-center">ELO</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var sp in _seasonParticipations)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <a href="/seasons/@sp.Season.Guid" class="text-decoration-none">@sp.Season.Name</a>
                                        </td>
                                        <td class="text-muted small">@sp.Season.League.Name</td>
                                        <td><span class="badge @sp.Season.Status.Badge()">@S[$"SeasonStatus_{sp.Season.Status}"]</span></td>
                                        <td class="text-center text-muted small">@sp.EloRating.ToString("F0")</td>
                                        <td>
                                            <a href="/teams/@_team!.Guid/seasons/@sp.Season.Guid" class="btn btn-outline-secondary btn-sm">
                                                <i class="bi bi-bar-chart me-1"></i>@S["TeamDetail_Stats"]
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private bool _loading = true, _isAdmin, _showAddPlayer;
    private Team? _team;
    private List<SeasonParticipant> _seasonParticipations = new();
    private List<Player> _availablePlayers = new();
    private Guid? _addPlayerGuid;
    private string _addPlayerPosition = "";

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = (await Auth.GetAuthenticationStateAsync()).User.IsInRole("Admin");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _team = await db.Teams
            .Include(t => t.TeamPlayers).ThenInclude(tp => tp.Player)
            .FirstOrDefaultAsync(t => t.Guid == Id);

        if (_team is not null)
        {
            _seasonParticipations = await db.SeasonParticipants
                .Where(sp => sp.TeamId == Id)
                .Include(sp => sp.Season).ThenInclude(s => s.League).ThenInclude(l => l.Sport)
                .OrderByDescending(sp => sp.Season.Year)
                .ToListAsync();

            var memberIds = _team.TeamPlayers.Select(tp => tp.PlayerId).ToHashSet();
            _availablePlayers = await db.Players
                .Where(p => !memberIds.Contains(p.Guid))
                .OrderBy(p => p.Name)
                .ToListAsync();
        }
        _loading = false;
    }

    private void ToggleAddPlayer() => _showAddPlayer = !_showAddPlayer;

    private async Task AddPlayerAsync()
    {
        if (_team is null || !_isAdmin || _addPlayerGuid is null || _addPlayerGuid == Guid.Empty) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.TeamPlayers.Add(new TeamPlayer
        {
            TeamId   = _team.Guid,
            PlayerId = _addPlayerGuid.Value,
            Position = string.IsNullOrWhiteSpace(_addPlayerPosition) ? null : _addPlayerPosition.Trim(),
            JoinedDate = DateOnly.FromDateTime(DateTime.Today)
        });
        await db.SaveChangesAsync();
        _showAddPlayer = false; _addPlayerGuid = null; _addPlayerPosition = "";
        Toast.ShowSuccess(S["TeamDetail_Added"], S["TeamDetail_PlayerAdded"]);
        await LoadAsync();
    }

    private async Task RemovePlayerAsync(Guid teamPlayerId)
    {
        if (!_isAdmin) return;
        if (!await Confirm.ShowAsync(S["TeamDetail_RemovePlayer"], S["TeamDetail_RemoveConfirm"], S["TeamDetail_Remove"], S["Cancel"]))
            return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var tp = await db.TeamPlayers.FindAsync(teamPlayerId);
        if (tp is not null) { db.TeamPlayers.Remove(tp); await db.SaveChangesAsync(); }
        Toast.ShowSuccess(S["TeamDetail_Removed"], S["TeamDetail_PlayerRemoved"]);
        await LoadAsync();
    }

}
