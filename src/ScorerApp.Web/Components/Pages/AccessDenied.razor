@page "/access-denied"
@layout MainLayout
@inject IStringLocalizer<SharedResource> S

@* Cookie auth posílá přihlášeného bez potřebné role sem (AccessDeniedPath ze SharedServices) — bez stránky to byla 404. *@
<PageTitle>@S["AccessDenied_Title"] — ScorerApp</PageTitle>

<div class="ui-panel ui-anim-fade-up p-5 text-center access-panel">
    <i class="bi bi-shield-lock fs-1 text-accent d-block mb-3"></i>
    <h3 class="mb-2">@S["AccessDenied_Title"]</h3>
    <p class="text-muted mb-4">@S["AccessDenied_Text"]</p>
    <a href="/" class="btn btn-primary">
        <i class="bi bi-house-door me-1"></i>@S["NotFound_BackToDashboard"]
    </a>
</div>
