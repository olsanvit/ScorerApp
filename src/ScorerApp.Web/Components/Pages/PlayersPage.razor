@page "/players"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider Auth
@inject IStringLocalizer<SharedResource> S

<PageTitle>@S["Players_Title"] — ScorerApp</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <h3><i class="bi bi-people"></i> @S["Players_Title"]</h3>
    @if (_isAdmin)
    {
        <a href="/admin/players/create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus me-1"></i>@S["NewPlayer"]
        </a>
    }
</div>

<UiSearchBar @bind-Value="_search"
             Placeholder="@S["Players_SearchPlaceholder"].Value"
             Count="@_filtered.Count"
             CountLabel="@S["Players_CountLabel"].Value"
             OnSearch="() => StateHasChanged()" />

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">@S["Loading"]</span>
    </div>
}
else
{
    <div class="ui-panel ui-anim-fade-up">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>@S["Players_Name"]</th>
                        <th>@S["Players_Nickname"]</th>
                        <th>@S["Players_Born"]</th>
                        <th class="text-center">@S["Players_Teams"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_filtered.Any())
                    {
                        <tr><td colspan="5" class="text-muted text-center py-4">@S["Players_Empty"]</td></tr>
                    }
                    @foreach (var p in _filtered)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a href="/players/@p.Guid" class="text-decoration-none">@p.Name</a>
                            </td>
                            <td class="text-muted small">@(p.Nickname ?? "—")</td>
                            <td class="text-muted small">@(p.DateOfBirth?.ToString("dd.MM.yyyy") ?? "—")</td>
                            <td class="text-center text-muted small">@p.TeamPlayers.Count</td>
                            <td>
                                <a href="/players/@p.Guid" class="btn btn-outline-secondary btn-sm">@S["Players_Detail"]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool _loading = true, _isAdmin;
    private string _search = "";
    private List<Player> _players = new();

    private List<Player> _filtered => string.IsNullOrWhiteSpace(_search)
        ? _players
        : _players.Where(p => p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                            || (p.Nickname?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
                  .ToList();

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = (await Auth.GetAuthenticationStateAsync()).User.IsInRole("Admin");
        await using var db = await DbFactory.CreateDbContextAsync();
        _players = await db.Players
            .Include(p => p.TeamPlayers)
            .OrderBy(p => p.Name)
            .ToListAsync();
        _loading = false;
    }
}
