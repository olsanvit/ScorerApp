@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<SharedResource> S

<PageTitle>@S["Error_Title"] — ScorerApp</PageTitle>

@* Výchozí šablona radila zapnout ASPNETCORE_ENVIRONMENT=Development — na produkci by pak stack trace viděl každý. *@
<div class="ui-panel ui-anim-fade-up p-5 text-center access-panel">
    <i class="bi bi-exclamation-triangle fs-1 text-danger d-block mb-3"></i>
    <h3 class="mb-2">@S["Error_Title"]</h3>
    <p class="text-muted mb-3">@S["Error_Text"]</p>
    @if (ShowRequestId)
    {
        <p class="small mb-4">@S["Error_RequestId"] <code>@RequestId</code></p>
    }
    <a href="/" class="btn btn-primary">
        <i class="bi bi-house-door me-1"></i>@S["NotFound_BackToDashboard"]
    </a>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
