@* AUDIT:FIXED|byl: Finish/Activate/Delete bez Admin role; nyní jen Admin *@
@page "/seasons/{Id:guid}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ScorerApp.Domain.Services.StandingsService StandingsSvc
@inject ScorerApp.Domain.Services.ScoringRulesService ScoringSvc
@inject SharedServices.ToastService Toast
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject ConfirmService Confirm
@inject ScorerApp.Domain.Services.PlayoffService Playoff
@inject ScorerApp.Domain.Services.SeasonScheduleService Schedule
@inject IStringLocalizer<SharedResource> S

<PageTitle>@(_season?.Name ?? S["Season_Fallback"].Value) — ScorerApp</PageTitle>

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-4">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">@S["Loading"]</span>
    </div>
}
else if (_season is null)
{
    <div class="alert alert-warning mt-4">@S["Season_NotFound"]</div>
}
else
{
    <div class="ui-page-header ui-anim-fade-up">
        <div class="d-flex align-items-center gap-3">
            <a href="/leagues/@_season.League.Guid" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
            <h3 class="m-0">@_season.Name</h3>
            <span class="badge bg-secondary">@_season.League.Name</span>
            <span class="badge @_season.Status.Badge()">@_season.Status.Label()</span>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/seasons/@_season.Guid/matches" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-controller me-1"></i>@S["Season_Matches"]
            </a>
            @if (_isAdmin)
            {
                @switch (_season.Status)
                {
                    case SeasonStatus.Draft:
                        <button class="btn btn-outline-success btn-sm" @onclick="OpenRegistrationAsync">
                            <i class="bi bi-door-open me-1"></i>@S["Season_OpenRegistration"]
                        </button>
                        break;
                    case SeasonStatus.Registration:
                        <a href="/admin/seasons/@_season.Guid/participants" class="btn btn-primary btn-sm">
                            <i class="bi bi-person-plus me-1"></i>@S["Season_PlayerRegistration"]
                        </a>
                        break;
                    case SeasonStatus.InProgress:
                        <a href="/admin/seasons/@_season.Guid/participants" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-people me-1"></i>@S["Season_Participants"]
                        </a>
                        <button class="btn btn-outline-warning btn-sm" @onclick="FinishSeasonAsync">
                            <i class="bi bi-flag-fill me-1"></i>@S["Season_Finish"]
                        </button>
                        break;
                    case SeasonStatus.Completed:
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ReopenSeasonAsync" title="@S["Season_ReopenHint"]">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>@S["Season_Reopen"]
                        </button>
                        break;
                }
                <a href="/admin/seasons/@_season.Guid/edit" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-pencil me-1"></i>@S["Season_Edit"]
                </a>
                <button class="btn btn-outline-danger btn-sm" title="@S["Season_Delete"]" @onclick="DeleteSeasonAsync">
                    <i class="bi bi-trash"></i>
                </button>
            }
        </div>
    </div>

    <!-- Info row -->
    <div class="row g-3 mb-4 ui-anim-fade-up">
        <div class="col-6 col-md-3">
            <UiStats Label="@S["Season_Participants"]" Value="@_season.Participants.Count.ToString()" Icon="bi-people" IconBgClass="icon-accent" />
        </div>
        <div class="col-6 col-md-3">
            <UiStats Label="@S["Season_TotalMatches"]" Value="@_season.Matches.Count.ToString()" Icon="bi-controller" IconBgClass="icon-emerald" />
        </div>
        <div class="col-6 col-md-3">
            <UiStats Label="@S["Season_Played"]" Value="@_season.Matches.Count(m => m.Status == MatchStatus.Played).ToString()" Icon="bi-check-circle" IconBgClass="icon-amber" />
        </div>
        <div class="col-6 col-md-3">
            <UiStats Label="@S["Season_Remaining"]" Value="@_season.Matches.Count(m => m.Status == MatchStatus.Scheduled).ToString()" Icon="bi-hourglass-split" IconBgClass="icon-purple" />
        </div>
    </div>

    <!-- Group tables -->
    @if (_groupTables.Count > 0)
    {
        <div class="row g-3 mb-4">
            @foreach (var (groupIndex, rows) in _groupTables)
            {
                <div class="col-lg-6">
                    <div class="ui-panel ui-anim-fade-up h-100">
                        <div class="ui-panel-header">
                            <span class="ui-panel-title"><i class="bi bi-grid-3x3 text-accent"></i> @S["Season_GroupTitle", GroupLabel(groupIndex)]</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-center">#</th><th>@S["Season_Participant"]</th>
                                        <th class="text-center">@S["Season_ColPlayed"]</th><th class="text-center">@S["Season_Score"]</th>
                                        <th class="text-center fw-bold">@S["Season_Points"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in rows)
                                    {
                                        <tr>
                                            <td class="text-center fw-bold text-muted">@r.Position</td>
                                            <td class="fw-semibold">@r.DisplayName</td>
                                            <td class="text-center text-muted small">@r.Played</td>
                                            <td class="text-center text-muted small">@r.GoalsFor:@r.GoalsAgainst</td>
                                            <td class="text-center fw-bold text-accent">@r.Points</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Playoff bracket -->
    @if (_bracket.Count > 0)
    {
        <div class="ui-panel ui-anim-fade-up mb-4">
            <div class="ui-panel-header">
                <span class="ui-panel-title"><i class="bi bi-diagram-3 text-accent"></i> @S["Playoff"]</span>
            </div>
            <PlayoffBracket Rounds="_bracket" />
        </div>
    }

    <!-- Next phase (admin) -->
    @if (_isAdmin && _phase is not null && _phase.AnythingGenerated && _phase.CurrentComplete
         && (_phase.NextModule is not null || _phase.CurrentModule?.Type == SeasonModuleType.Swiss))
    {
        <div class="ui-panel ui-anim-fade-up mb-4 p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="small">
                <i class="bi bi-arrow-right-circle text-accent me-1"></i>
                @S["Season_PhaseDone"]
            </span>
            <a href="/admin/seasons/@Id/generate" class="btn btn-primary btn-sm">@S["GenerateNextPhase"]</a>
        </div>
    }

    <!-- Standings -->
    @if (_standings.Count > 0)
    {
        <div class="ui-panel ui-anim-fade-up mb-4">
            <div class="ui-panel-header">
                <span class="ui-panel-title"><i class="bi bi-table text-accent"></i> @S["Season_Standings"]</span>
                @if (_season.Matches.Any() && !_season.Matches.Any(m => m.Status == MatchStatus.Played))
                {
                    <span class="badge bg-secondary">@S["Season_NoPlayedMatches"]</span>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="text-center">#</th>
                            <th>@S["Season_Participant"]</th>
                            <th class="text-center">@S["Season_ColPlayed"]</th>
                            <th class="text-center">@S["Season_ColWon"]</th>
                            @if (_rules?.HasDraw == true)
                            {
                                <th class="text-center">@S["Season_ColDrawn"]</th>
                            }
                            <th class="text-center">@S["Season_ColLost"]</th>
                            <th class="text-center">@S["Season_Score"]</th>
                            <th class="text-center fw-bold">@S["Season_Points"]</th>
                            @if (_season.UseElo)
                            {
                                <th class="text-center">ELO</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _standings)
                        {
                            <tr>
                                <td class="text-center fw-bold text-muted">@r.Position</td>
                                <td class="fw-semibold">@r.DisplayName</td>
                                <td class="text-center text-muted small">@r.Played</td>
                                <td class="text-center text-success small">@r.Won</td>
                                @if (_rules?.HasDraw == true)
                                {
                                    <td class="text-center text-muted small">@r.Drawn</td>
                                }
                                <td class="text-center text-danger small">@r.Lost</td>
                                <td class="text-center text-muted small">@r.GoalsFor:@r.GoalsAgainst</td>
                                <td class="text-center fw-bold text-accent">@r.Points</td>
                                @if (_season.UseElo)
                                {
                                    <td class="text-center text-muted small">@r.EloRating.ToString("F0")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (_season.Participants.Count == 0)
    {
        <div class="ui-panel ui-anim-fade-up p-4 text-center text-muted mb-4">
            <i class="bi bi-people fs-3 d-block mb-2"></i>
            @S["Season_NoParticipants"] <a href="/admin/seasons/@_season.Guid/participants">@S["Season_AddParticipants"]</a>
        </div>
    }

    <!-- Races -->
    @if (_races.Count > 0 || (_isAdmin && _season.Status == SeasonStatus.InProgress))
    {
        <div class="ui-panel ui-anim-fade-up mb-4">
            <div class="ui-panel-header">
                <span class="ui-panel-title"><i class="bi bi-person-walking text-accent"></i> @S["Season_Races"]</span>
                @if (_isAdmin && _season.Status == SeasonStatus.InProgress)
                {
                    <a href="/admin/races/create?seasonId=@_season.Guid" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-plus me-1"></i>@S["Season_AddRace"]
                    </a>
                }
            </div>
            @if (!_races.Any())
            {
                <div class="p-4 text-muted text-center small">@S["Season_NoRaces"]</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>@S["Season_RaceName"]</th>
                                <th class="text-center">@S["Season_RaceDate"]</th>
                                <th class="text-center">@S["Season_RaceDistance"]</th>
                                <th class="text-center">@S["Season_RaceResults"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _races.OrderBy(r => r.RaceDate ?? DateOnly.MaxValue))
                            {
                                <tr>
                                    <td class="fw-semibold">@r.Name</td>
                                    <td class="text-center text-muted small">
                                        @(r.RaceDate.HasValue ? r.RaceDate.Value.ToString("dd.MM.yyyy") : "—")
                                    </td>
                                    <td class="text-center text-muted small">
                                        @(r.Distance.HasValue ? $"{r.Distance} {r.DistanceUnit ?? "km"}" : "—")
                                    </td>
                                    <td class="text-center text-muted small">@r.RaceResults.Count</td>
                                    <td>
                                        <a href="/races/@r.Guid" class="btn btn-outline-secondary btn-sm">@S["Season_Detail"]</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- Last results -->
    @if (_lastPlayed.Count > 0)
    {
        <div class="ui-panel ui-anim-fade-up">
            <div class="ui-panel-header">
                <span class="ui-panel-title"><i class="bi bi-clock-history text-accent"></i> @S["Season_LastResults"]</span>
                <a href="/seasons/@_season.Guid/matches" class="btn btn-outline-secondary btn-sm">@S["Season_AllMatches"]</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr><th>@S["Season_Round"]</th><th>@S["Season_Home"]</th><th class="text-center">@S["Season_Result"]</th><th>@S["Season_Away"]</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _lastPlayed)
                        {
                            <tr>
                                <td class="text-muted small">@S["Season_RoundShort", m.Round]</td>
                                <td class="fw-semibold small">@m.HomeParticipant.DisplayName</td>
                                <td class="text-center">
                                    <span class="badge @ScoreBadge(m)">@m.HomeScore : @m.AwayScore</span>
                                </td>
                                <td class="fw-semibold small">@m.AwayParticipant.DisplayName</td>
                                <td><a href="/matches/@m.Guid" class="btn btn-outline-secondary btn-sm">@S["Season_Detail"]</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }
    private bool _loading = true;
    private bool _isAdmin;
    private Season? _season;
    private List<ScorerApp.Domain.Services.StandingsRow> _standings = new();
    private List<(int GroupIndex, List<ScorerApp.Domain.Services.StandingsRow> Rows)> _groupTables = new();
    private List<ScorerApp.Domain.Services.BracketRound> _bracket = new();
    private ScorerApp.Domain.Services.SeasonPhaseStatus? _phase;
    private List<Match> _lastPlayed = new();
    private List<Race> _races = new();
    private ScorerApp.Domain.Services.ScoringRules? _rules;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = (await Auth.GetAuthenticationStateAsync()).User.IsInRole("Admin");
        await using var db = await DbFactory.CreateDbContextAsync();
        _season = await db.Seasons
            .Include(s => s.League).ThenInclude(l => l.Sport)
            .Include(s => s.Participants).ThenInclude(p => p.Player)
            .Include(s => s.Participants).ThenInclude(p => p.Team)
            .Include(s => s.Matches).ThenInclude(m => m.HomeParticipant).ThenInclude(p => p.Player)
            .Include(s => s.Matches).ThenInclude(m => m.HomeParticipant).ThenInclude(p => p.Team)
            .Include(s => s.Matches).ThenInclude(m => m.AwayParticipant).ThenInclude(p => p.Player)
            .Include(s => s.Matches).ThenInclude(m => m.AwayParticipant).ThenInclude(p => p.Team)
            .FirstOrDefaultAsync(s => s.Guid == Id);

        if (_season is not null)
        {
            _rules = ScoringSvc.Resolve(_season.League.Sport, _season.League);

            // Do tabulky patří jen ligové/skupinové zápasy — playoff se do pořadí nepočítá.
            var tableMatches = _season.Matches.Where(m => m.Stage != MatchStage.Playoff).ToList();

            if (tableMatches.Any(m => m.GroupIndex.HasValue))
            {
                foreach (var group in tableMatches.Where(m => m.GroupIndex.HasValue)
                                                  .GroupBy(m => m.GroupIndex!.Value)
                                                  .OrderBy(g => g.Key))
                {
                    var memberIds = group.SelectMany(m => new[] { m.HomeParticipantId, m.AwayParticipantId }).ToHashSet();
                    var members   = _season.Participants.Where(p => memberIds.Contains(p.Guid)).ToList();
                    _groupTables.Add((group.Key,
                        StandingsSvc.Calculate(_season, group.ToList(), _rules, members)));
                }
            }
            else
            {
                _standings = StandingsSvc.Calculate(_season, tableMatches, _rules);
            }

            _bracket = await Playoff.GetBracketAsync(Id);
            _phase   = await Schedule.GetPhaseStatusAsync(Id);
            _lastPlayed = _season.Matches
                .Where(m => m.Status == MatchStatus.Played)
                .OrderByDescending(m => m.UpdatedAt)
                .Take(5).ToList();
            _races = await db.Races
                .Where(r => r.SeasonId == Id)
                .Include(r => r.RaceResults)
                .OrderBy(r => r.RaceDate)
                .ToListAsync();
        }
        _loading = false;
    }

    private async Task ChangeStatusAsync(SeasonStatus newStatus)
    {
        if (_season is null || !_isAdmin) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var s = await db.Seasons.FindAsync(_season.Guid);
        if (s is null) return;
        s.Status    = newStatus;
        s.UpdatedAt = DateTimeOffset.UtcNow;
        await db.SaveChangesAsync();
        _season.Status = newStatus;
        Toast.ShowSuccess(S["Season_Done"], S["Season_StatusChanged", newStatus.Label()]);
        StateHasChanged();
    }

    private Task FinishSeasonAsync() => ChangeStatusAsync(SeasonStatus.Completed);
    private Task ReopenSeasonAsync() => ChangeStatusAsync(SeasonStatus.InProgress);

    private async Task OpenRegistrationAsync()
    {
        await ChangeStatusAsync(SeasonStatus.Registration);
        Nav.NavigateTo($"/admin/seasons/{Id}/participants");
    }

    private async Task DeleteSeasonAsync()
    {
        if (_season is null || !_isAdmin) return;
        if (!await Confirm.ShowAsync(S["Season_Delete"],
                S["Season_DeleteConfirm", _season.Name],
                S["Season_DeleteButton"], S["Cancel"]))
            return;
        var leagueGuid = _season.League.Guid;
        await using var db = await DbFactory.CreateDbContextAsync();
        var s = await db.Seasons.FindAsync(_season.Guid);
        if (s is not null) { db.Seasons.Remove(s); await db.SaveChangesAsync(); }
        Toast.ShowSuccess(S["Season_Deleted"], S["Season_DeletedMessage"]);
        Nav.NavigateTo($"/leagues/{leagueGuid}");
    }

    private static string ScoreBadge(Match m)
    {
        if (m.HomeScore > m.AwayScore) return "bg-success";
        if (m.HomeScore < m.AwayScore) return "bg-danger";
        return "bg-secondary";
    }

    /// <summary>Skupiny se uživateli ukazují jako A, B, C… i když se interně indexují od 1.</summary>
    private static string GroupLabel(int groupIndex) => ((char)('A' + groupIndex - 1)).ToString();
}
