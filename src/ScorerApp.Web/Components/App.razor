@inject SharedServices.Services.ThemeService ThemeService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@implements IDisposable

<!DOCTYPE html>
<html lang="cs" data-bs-theme="@ThemeService.BsThemeAttr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@BaseHref" />
    <link rel="stylesheet" href="@ThemeService.CurrentThemeUrl" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ScorerApp.Web.styles.css"]" />
    <link rel="stylesheet" href="@Assets["_content/SharedServices/SharedServices.bundle.scp.css"]" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="_content/Blazored.Modal/blazored-modal.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/Blazor-ApexCharts/js/blazor-apexcharts.js"></script>
</body>

</html>

@code {
    // Cloudflare Tunnel dává appce vlastní subdoménu (žádný PathBase), ale appka
    // podporuje i nasazení za sdíleným reverse proxy s PathBase (např. "/scorer").
    // Natvrdo "/" by v tom případě odpojilo SignalR okruh (cookie i hub endpoint
    // jsou svázané s PathBase, zatímco base href by mířil mimo něj).
    private string BaseHref => $"{HttpContextAccessor.HttpContext?.Request.PathBase}/";

    protected override void OnInitialized() => ThemeService.OnChange += StateHasChanged;
    public void Dispose() => ThemeService.OnChange -= StateHasChanged;
}
