@inject IStringLocalizer<SharedResource> S

<div class="top-row ps-3 navbar">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="">
            <i class="bi bi-trophy-fill me-2 text-accent"></i>ScorerApp
        </a>
    </div>
</div>

<input type="checkbox" title="@S["Nav_ToggleMenu"]" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house-door me-2"></i> @S["Home_Dashboard"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/leagues">
                        <i class="bi bi-trophy me-2"></i> @S["Nav_Leagues"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/seasons">
                        <i class="bi bi-calendar3 me-2"></i> @S["Nav_Seasons"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/matches">
                        <i class="bi bi-controller me-2"></i> @S["Nav_Matches"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/players">
                        <i class="bi bi-people me-2"></i> @S["Nav_Players"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/teams">
                        <i class="bi bi-shield me-2"></i> @S["Nav_Teams"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/rankings">
                        <i class="bi bi-bar-chart-steps me-2"></i> @S["Rankings"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/profile">
                        <i class="bi bi-person-badge me-2"></i> @S["Profile"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/races">
                        <i class="bi bi-person-walking me-2"></i> @S["Nav_Races"]
                    </NavLink>
                </div>

                @* Kluby jsou hlavní sekce, ne admin: správce organizace nebo oddílu nemusí být admin aplikace. *@
                <hr class="nav-divider" />
                <div class="nav-item px-3">
                    <span class="nav-link text-muted small text-uppercase py-1" style="letter-spacing:.05em">@S["Clubs_Section"]</span>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/clubs">
                        <i class="bi bi-shield-fill me-2"></i> @S["Clubs_Clubs"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/organizations">
                        <i class="bi bi-buildings me-2"></i> @S["Clubs_Organizations"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/chat">
                        <i class="bi bi-chat-dots me-2"></i> @S["Clubs_Chat"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/circulars">
                        <i class="bi bi-envelope-paper me-2"></i> @S["Clubs_Circulars"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/cars/reservations">
                        <i class="bi bi-car-front me-2"></i> @S["Clubs_Reservations"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/join">
                        <i class="bi bi-box-arrow-in-right me-2"></i> @S["Clubs_JoinByCode"]
                    </NavLink>
                </div>

                <AuthorizeView Roles="Admin" Context="adminCtx">
                    <Authorized>
                        <hr class="nav-divider" />
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="/admin">
                                <i class="bi bi-shield-lock me-2"></i> @S["Nav_Admin"]
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="/admin/sports">
                                <i class="bi bi-activity me-2"></i> @S["Sports"]
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="/admin/users">
                                <i class="bi bi-people me-2"></i> @S["AdminUsers_Title"]
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="/register">
                                <i class="bi bi-person-plus me-2"></i> @S["Nav_RegisterUser"]
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <hr class="nav-divider" />
                <div class="nav-item px-3">
                    <span class="nav-link text-muted small">
                        <i class="bi bi-person-circle me-1"></i>@context.User.Identity?.Name
                    </span>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/logout">
                        <i class="bi bi-box-arrow-right me-2"></i> @S["Nav_Logout"]
                    </a>
                </div>
                <ThemePicker />
                <LangSwitcher />
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/login">
                        <i class="bi bi-box-arrow-in-right me-2"></i> @S["Nav_Login"]
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

<style>
    .nav-divider { border-color: rgba(255,255,255,.15); margin: .5rem 1rem; }
</style>
