@inherits LayoutComponentBase
@inject SharedServices.Services.UiLibraryService UiLib
@implements IDisposable
@inject IStringLocalizer<SharedResource> S

<UiProviders />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <article class="content px-4 py-3">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="alert alert-danger m-3" role="alert">
                        <h4 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i>@S["Layout_ErrorTitle"]</h4>
                        <p>@S["Layout_ErrorText"]</p>
                        <hr />
                        <p class="mb-0 text-muted small">@ex.Message</p>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<Toast />
<ConfirmDialog />
<ConnectionBanner />

<div id="blazor-error-ui" data-nosnippet>
    @S["Layout_UnexpectedError"] <a href="." class="reload">@S["Layout_Reload"]</a>
    <span class="dismiss">×</span>
</div>

@code {
    protected override void OnInitialized() => UiLib.OnChanged += StateHasChanged;
    public void Dispose()                   => UiLib.OnChanged -= StateHasChanged;
}
